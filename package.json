{
  "name": "kotori-lp",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:works && npm run check:editorial && npm run check:changelog && astro build && npm run check:work-deployment",
    "check:works": "node scripts/validate-work-pages.mjs",
    "check:work-deployment": "node scripts/validate-work-deployment.mjs",
    "check:editorial": "node scripts/validate-editorial.mjs",
    "check:changelog": "node scripts/validate-changelog.mjs",
    "check:changelog:source": "node scripts/validate-changelog.mjs --require-source",
    "sync:editorial:app": "node scripts/sync-editorial-to-app.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/vercel": "^9.0.4",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^5.17.1",
    "tailwindcss": "^4.2.1"
  }
}
