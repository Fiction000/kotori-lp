---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  {
    number: '1',
    title: t('howitworks.step1.title'),
    description: t('howitworks.step1.description'),
  },
  {
    number: '2',
    title: t('howitworks.step2.title'),
    description: t('howitworks.step2.description'),
  },
  {
    number: '3',
    title: t('howitworks.step3.title'),
    description: t('howitworks.step3.description'),
  },
];
---

<section class="pt-12 pb-24 md:pt-16 md:pb-36">
  <div class="how-it-works mx-auto max-w-6xl px-6">
    <div class="fade-up how-it-works__intro">
      <h2 class="font-koburi text-3xl leading-tight text-sepia-900 md:text-4xl">
        {t('howitworks.title')}
      </h2>
      <p class="max-w-md text-base leading-relaxed text-sepia-700 md:text-lg">
        {t('howitworks.subtitle')}
      </p>
      {lang === 'ja' && (
        <a href="/guides/aozora-tategaki/" class="inline-flex min-h-11 w-fit items-center text-sm font-medium text-sepia-800 underline decoration-sepia-300 underline-offset-4 transition-colors hover:text-kotori-green">
          {t('howitworks.guideLink')}
        </a>
      )}
    </div>

    <ol class="fade-up reading-sequence" aria-label={t('howitworks.title')}>
      {steps.map((step) => (
        <li class="reading-sequence__item">
          <div class="reading-sequence__heading">
            <span class="reading-sequence__number" aria-hidden="true">{step.number}</span>
            <h3 class="font-koburi text-2xl leading-tight text-sepia-900">
              {step.title}
            </h3>
          </div>
          <p class="text-base leading-relaxed text-sepia-700">
            {step.description}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how-it-works {
    display: grid;
    gap: 3rem;
  }

  .how-it-works__intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .reading-sequence {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(82, 58, 34, 0.16);
  }

  .reading-sequence__item {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(82, 58, 34, 0.16);
  }

  .reading-sequence__heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .reading-sequence__number {
    color: var(--color-kotori-green);
    font-size: 0.875rem;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .reading-sequence {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid rgba(82, 58, 34, 0.16);
    }

    .reading-sequence__item {
      min-height: 11rem;
      padding: 2rem 2rem 2rem 0;
      border-bottom: 0;
    }

    .reading-sequence__item + .reading-sequence__item {
      padding-right: 2rem;
      padding-left: 2rem;
      border-left: 1px solid rgba(82, 58, 34, 0.16);
    }

    .reading-sequence__item:last-child { padding-right: 0; }
  }

</style>
