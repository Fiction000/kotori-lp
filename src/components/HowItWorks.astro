---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  {
    title: t('howitworks.step1.title'),
    description: t('howitworks.step1.description'),
  },
  {
    title: t('howitworks.step2.title'),
    description: t('howitworks.step2.description'),
  },
  {
    title: t('howitworks.step3.title'),
    description: t('howitworks.step3.description'),
  },
];
---

<section class="how-it-works-section pt-12 pb-24 md:pt-16 md:pb-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="how-it-works">
      <header class="fade-up how-it-works__intro">
        <h2 class="font-koburi text-3xl leading-tight text-sepia-900 md:text-4xl">
          {t('howitworks.title')}
        </h2>
        <p class="max-w-xl text-base leading-relaxed text-sepia-700 md:text-lg">
          {t('howitworks.subtitle')}
        </p>
        {lang === 'ja' && (
          <a href="/guides/aozora-tategaki/" class="inline-flex min-h-11 w-fit items-center text-sm font-medium text-sepia-800 underline decoration-sepia-300 underline-offset-4 transition-colors hover:text-kotori-green">
            {t('howitworks.guideLink')}
          </a>
        )}
      </header>

      <ol class="fade-up reading-progression" aria-label={t('howitworks.title')}>
        {steps.map((step) => (
          <li class="reading-progression__step">
            <h3 class="font-koburi text-2xl leading-tight text-sepia-900 md:text-3xl">{step.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-sepia-700">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    display: grid;
    gap: 2.5rem;
  }

  .how-it-works__intro {
    display: grid;
    gap: 1rem;
  }

  .reading-progression {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-progression__step {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .how-it-works {
      grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
      align-items: start;
      gap: clamp(3rem, 7vw, 6rem);
    }

    .reading-progression {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progression__step {
      transition: none;
    }
  }
</style>
