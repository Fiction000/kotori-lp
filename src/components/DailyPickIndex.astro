---
import AppStoreBadge from './AppStoreBadge.astro';
import type { EditorialLocale } from '../data/editorial';
import { dailyPick, editorialManifest, localizedPick, readyPicks } from '../data/editorial';

interface Props {
  lang: EditorialLocale;
}

const { lang } = Astro.props;
const pathPrefix = lang === 'en' ? '/en' : '';
const picks = readyPicks().map((pick) => localizedPick(pick, lang));
const initialPick = localizedPick(dailyPick(), lang);
const copy = lang === 'ja'
  ? {
      eyebrow: 'KOTORI DAILY',
      title: '今日の1冊',
      intro: '青空文庫から、今日ひらきたい一冊を。短い紹介を入口に、まだ知らない作品と出会えます。',
      today: 'TODAY',
      archive: 'これまでの選書',
      details: '読みどころを見る',
      cta: '気になった作品は、コトリでそのまま縦書きで。',
    }
  : {
      eyebrow: 'KOTORI DAILY',
      title: "Today's Pick",
      intro: 'One work from Aozora Bunko for today. A quiet doorway into Japanese literature you may not have searched for.',
      today: 'TODAY',
      archive: 'The selection',
      details: 'Read the introduction',
      cta: 'Continue with the work in Kotori’s vertical reader.',
    };

const clientPicks = picks.map(({ id, title, author, summaryLines }) => ({
  id,
  title,
  author,
  summary: summaryLines[0],
  href: `${pathPrefix}/daily/${id}/`,
}));
const rotation = editorialManifest.rotation;
---

<section class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-y-10 right-[8%] hidden select-none font-koburi text-[7rem] leading-loose text-sepia-100 writing-vertical md:block" aria-hidden="true">
    {lang === 'ja' ? '今日の一冊' : 'DAILY'}
  </div>
  <div class="relative mx-auto max-w-5xl px-6">
    <p class="fade-up mb-4 text-xs font-semibold tracking-[0.22em] text-sepia-700">{copy.eyebrow}</p>
    <div class="grid gap-12 md:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)] md:items-end">
      <div>
        <h1 class="fade-up font-koburi text-5xl leading-tight text-sepia-900 md:text-7xl">{copy.title}</h1>
        <p class="fade-up mt-6 max-w-2xl text-lg leading-8 text-sepia-700">{copy.intro}</p>
      </div>
      <a
        id="daily-feature"
        href={`${pathPrefix}/daily/${initialPick.id}/`}
        class="fade-up group block rounded-[2rem] border border-sepia-200 bg-sepia-50/70 p-7 shadow-sm transition-[transform,box-shadow,background-color] duration-300 hover:-translate-y-1 hover:bg-white/70 hover:shadow-lg"
      >
        <p class="mb-3 text-xs font-medium tracking-[0.2em] text-sepia-700">{copy.today}</p>
        <h2 id="daily-feature-title" class="font-koburi text-3xl text-sepia-900 md:text-4xl">{initialPick.title}</h2>
        <p id="daily-feature-author" class="mt-2 text-sm text-sepia-700">{initialPick.author}</p>
        <p id="daily-feature-summary" class="mt-5 text-sm leading-7 text-sepia-700">{initialPick.summaryLines[0]}</p>
        <p class="mt-5 text-sm font-semibold text-sepia-700">{copy.details}</p>
      </a>
    </div>
  </div>
</section>

<section class="py-16 md:py-24" aria-labelledby="daily-archive-heading">
  <div class="mx-auto max-w-5xl px-6">
    <h2 id="daily-archive-heading" class="fade-up mb-8 font-koburi text-3xl text-sepia-900">{copy.archive}</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {picks.map((pick) => (
        <a href={`${pathPrefix}/daily/${pick.id}/`} class="fade-up group rounded-3xl border border-sepia-200 bg-white/35 p-7 transition-colors hover:bg-white/60">
          <p class="mb-3 text-xs font-medium tracking-[0.16em] text-sepia-700">{pick.author}</p>
          <h3 class="font-koburi text-3xl text-sepia-900 group-hover:text-kotori-dark">{pick.title}</h3>
          <p class="mt-4 text-sm leading-7 text-sepia-700">{pick.summaryLines[1]}</p>
          <p class="mt-5 text-sm font-semibold text-sepia-700">{copy.details}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="py-20 text-center">
  <p class="fade-up mb-8 font-koburi text-2xl text-sepia-700">{copy.cta}</p>
  <div class="fade-up"><AppStoreBadge /></div>
</section>

<script define:vars={{ clientPicks, rotation }}>
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(new Date());
  const part = (type) => Number(parts.find((item) => item.type === type)?.value);
  const serialDay = (year, month, day) => Math.floor(Date.UTC(year, month - 1, day) / 86400000);
  const [anchorYear, anchorMonth, anchorDay] = rotation.effectiveFrom.split('-').map(Number);
  const elapsed = serialDay(part('year'), part('month'), part('day'))
    - serialDay(anchorYear, anchorMonth, anchorDay);
  const index = ((elapsed % clientPicks.length) + clientPicks.length) % clientPicks.length;
  const pick = clientPicks[index];

  const feature = document.getElementById('daily-feature');
  const title = document.getElementById('daily-feature-title');
  const author = document.getElementById('daily-feature-author');
  const summary = document.getElementById('daily-feature-summary');
  if (feature instanceof HTMLAnchorElement) feature.href = pick.href;
  if (title) title.textContent = pick.title;
  if (author) author.textContent = pick.author;
  if (summary) summary.textContent = pick.summary;
</script>

<style>
  .writing-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
</style>
