---
import { getLangFromUrl, useTranslations, getLocalePath } from '../i18n/utils';

interface Props {
  showLanguageSwitcher?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const showLanguageSwitcher = Astro.props.showLanguageSwitcher ?? true;
const altLang = lang === 'ja' ? 'en' : 'ja';
const pathWithoutLang = lang === 'ja'
  ? Astro.url.pathname
  : Astro.url.pathname.replace(/^\/en/, '') || '/';
const altPath = altLang === 'ja'
  ? pathWithoutLang
  : `/en${pathWithoutLang}`;
---

<header class="sticky top-0 z-50 bg-kotori-warm/80 backdrop-blur-md border-b border-sepia-200/50">
  <nav class="mx-auto max-w-7xl flex items-center justify-between px-6 py-4">
    <a href={getLocalePath(lang, '/')} class="flex min-h-11 items-center gap-2 rounded-lg font-bold text-lg text-sepia-800">
      <img src="/app-icon-288-v1.webp" alt="" width="288" height="288" class="w-8 h-8 rounded-lg" />
      <span class="font-koburi">{t('brand.name')}</span>
    </a>

    <div class="flex items-center gap-6 text-sm">
      <a href={getLocalePath(lang, '/#features')} class="hidden text-sepia-700 transition-colors hover:text-sepia-900 lg:block">
        {t('nav.features')}
      </a>
      {lang === 'ja' && (
        <a href="/works/" class="hidden text-sepia-700 transition-colors hover:text-sepia-900 lg:block">
          {t('nav.works')}
        </a>
      )}
      <a href={getLocalePath(lang, '/weekly/')} class="hidden text-sepia-700 transition-colors hover:text-sepia-900 lg:block">
        {t('nav.weekly')}
      </a>
      <a href={getLocalePath(lang, '/changelog')} class="hidden text-sepia-700 transition-colors hover:text-sepia-900 lg:block">
        {t('nav.changelog')}
      </a>
      <a href={getLocalePath(lang, '/privacy')} class="hidden text-sepia-700 transition-colors hover:text-sepia-900 lg:block">
        {t('nav.privacy')}
      </a>
      <a href={getLocalePath(lang, '/support')} class="hidden text-sepia-700 transition-colors hover:text-sepia-900 lg:block">
        {t('nav.support')}
      </a>
      {showLanguageSwitcher && (
        <a
          href={altPath}
          class="inline-flex min-h-11 items-center rounded-full border border-sepia-300 px-4 text-xs font-medium text-sepia-700 transition-colors hover:bg-sepia-100"
        >
          {altLang === 'ja' ? '日本語' : 'English'}
        </a>
      )}

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="flex h-11 w-11 items-center justify-center rounded-lg text-sepia-700 hover:text-sepia-900 lg:hidden"
        aria-label={t('nav.menu')}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-sepia-200/50 bg-kotori-warm/95 backdrop-blur-md">
    <div class="px-6 py-4 flex flex-col gap-3">
      <a href={getLocalePath(lang, '/#features')} class="flex min-h-11 items-center rounded-lg text-sepia-700 transition-colors hover:text-sepia-900">
        {t('nav.features')}
      </a>
      {lang === 'ja' && (
        <a href="/works/" class="flex min-h-11 items-center rounded-lg text-sepia-700 transition-colors hover:text-sepia-900">
          {t('nav.works')}
        </a>
      )}
      <a href={getLocalePath(lang, '/weekly/')} class="flex min-h-11 items-center rounded-lg text-sepia-700 transition-colors hover:text-sepia-900">
        {t('nav.weekly')}
      </a>
      <a href={getLocalePath(lang, '/changelog')} class="flex min-h-11 items-center rounded-lg text-sepia-700 transition-colors hover:text-sepia-900">
        {t('nav.changelog')}
      </a>
      <a href={getLocalePath(lang, '/privacy')} class="flex min-h-11 items-center rounded-lg text-sepia-700 transition-colors hover:text-sepia-900">
        {t('nav.privacy')}
      </a>
      <a href={getLocalePath(lang, '/support')} class="flex min-h-11 items-center rounded-lg text-sepia-700 transition-colors hover:text-sepia-900">
        {t('nav.support')}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  function setMenuOpen(open: boolean) {
    const iconPath = open
      ? 'M6 18L18 6M6 6l12 12'
      : 'M4 6h16M4 12h16M4 18h16';

    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    icon?.setAttribute('d', iconPath);
  }

  btn?.addEventListener('click', () => {
    setMenuOpen(menu?.classList.contains('hidden') ?? false);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setMenuOpen(false);
      btn?.focus();
    }
  });
</script>
