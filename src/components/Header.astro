---
import { getLangFromUrl, useTranslations, getLocalePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLang = lang === 'ja' ? 'en' : 'ja';
const pathWithoutLang = lang === 'ja'
  ? Astro.url.pathname
  : Astro.url.pathname.replace(/^\/en/, '') || '/';
const altPath = altLang === 'ja'
  ? pathWithoutLang
  : `/en${pathWithoutLang}`;
---

<header class="sticky top-0 z-50 bg-kotori-warm/80 backdrop-blur-md border-b border-sepia-200/50">
  <nav class="mx-auto max-w-5xl flex items-center justify-between px-6 py-4">
    <a href={getLocalePath(lang, '/')} class="flex min-h-11 items-center gap-2 rounded-lg font-bold text-lg text-sepia-800">
      <img src="/app-icon.png" alt="" width="1024" height="1024" class="w-8 h-8 rounded-lg" />
      <span class="font-koburi">コトリ</span>
    </a>

    <div class="flex items-center gap-6 text-sm">
      <a href={getLocalePath(lang, '/#features')} class="text-sepia-600 hover:text-sepia-800 transition-colors hidden sm:block">
        {t('nav.features')}
      </a>
      <a href={getLocalePath(lang, '/daily/')} class="text-sepia-600 hover:text-sepia-800 transition-colors hidden sm:block">
        {t('nav.daily')}
      </a>
      <a href={getLocalePath(lang, '/privacy')} class="text-sepia-600 hover:text-sepia-800 transition-colors hidden sm:block">
        {t('nav.privacy')}
      </a>
      <a href={getLocalePath(lang, '/support')} class="text-sepia-600 hover:text-sepia-800 transition-colors hidden sm:block">
        {t('nav.support')}
      </a>
      <a
        href={altPath}
        class="inline-flex min-h-11 items-center rounded-full border border-sepia-300 px-4 text-xs text-sepia-600 transition-colors hover:bg-sepia-100"
      >
        {altLang === 'ja' ? '日本語' : 'English'}
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="sm:hidden flex items-center justify-center w-11 h-11 rounded-lg text-sepia-600 hover:text-sepia-800"
        aria-label={t('nav.menu')}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-sepia-200/50 bg-kotori-warm/95 backdrop-blur-md">
    <div class="px-6 py-4 flex flex-col gap-3">
      <a href={getLocalePath(lang, '/#features')} class="flex min-h-11 items-center rounded-lg text-sepia-600 hover:text-sepia-800 transition-colors">
        {t('nav.features')}
      </a>
      <a href={getLocalePath(lang, '/daily/')} class="flex min-h-11 items-center rounded-lg text-sepia-600 hover:text-sepia-800 transition-colors">
        {t('nav.daily')}
      </a>
      <a href={getLocalePath(lang, '/privacy')} class="flex min-h-11 items-center rounded-lg text-sepia-600 hover:text-sepia-800 transition-colors">
        {t('nav.privacy')}
      </a>
      <a href={getLocalePath(lang, '/support')} class="flex min-h-11 items-center rounded-lg text-sepia-600 hover:text-sepia-800 transition-colors">
        {t('nav.support')}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  function setMenuOpen(open: boolean) {
    const iconPath = open
      ? 'M6 18L18 6M6 6l12 12'
      : 'M4 6h16M4 12h16M4 18h16';

    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    icon?.setAttribute('d', iconPath);
  }

  btn?.addEventListener('click', () => {
    setMenuOpen(menu?.classList.contains('hidden') ?? false);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setMenuOpen(false);
      btn?.focus();
    }
  });
</script>
