---
import AppStoreBadge from './AppStoreBadge.astro';
import { workPagePathForBookID, type WorkPage } from '../data/work-pages';
import { authorHubPath, collectionMembershipForWork, readyAuthorHubForWork } from '../data/work-catalog';

interface Props {
  work: WorkPage;
}

const { work } = Astro.props;
const relatedWorks = work.relatedWorks.map((related) => ({
  ...related,
  path: workPagePathForBookID(related.bookID),
}));
const authorHub = readyAuthorHubForWork(work);
const collections = collectionMembershipForWork(work);
---

<article class="work-page">
  <section class="work-hero relative overflow-hidden border-b border-sepia-200/70">
    <div class="relative mx-auto max-w-6xl px-6 pb-20 pt-10 md:pb-28 md:pt-14">
      <nav aria-label="パンくず" class="fade-up flex flex-wrap items-center gap-2 text-xs text-sepia-600">
        <a href="/" class="rounded-sm hover:text-sepia-900">ホーム</a>
        <span aria-hidden="true">／</span>
        <a href="/works/" class="rounded-sm hover:text-sepia-900">作品案内</a>
        <span aria-hidden="true">／</span>
        <span aria-current="page">{work.title}</span>
      </nav>

      <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,0.82fr)_minmax(26rem,1.18fr)] lg:items-end">
        <div class="relative z-10">
          <h1 class="fade-up font-koburi text-sepia-900">
            <span class="block text-[clamp(2.5rem,5vw,4rem)] leading-[1.15] tracking-[-0.03em]">{work.title}</span>
            <span class="mt-6 block text-xl font-normal tracking-[0.1em] text-sepia-700 md:text-2xl">{work.author}</span>
          </h1>
          <p class="fade-up mt-9 max-w-xl text-base leading-8 text-sepia-700 md:text-lg md:leading-9">{work.lead}</p>
        </div>

        <figure class="fade-up relative">
          <img
            src={work.image}
            alt={work.imageAlt}
            width="1536"
            height="1024"
            fetchpriority="high"
            class="aspect-[3/2] w-full bg-sepia-100 object-cover"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28" aria-labelledby="synopsis-heading">
    <div class="mx-auto grid max-w-5xl gap-12 px-6 md:grid-cols-[10rem_minmax(0,1fr)]">
      <div class="fade-up border-t border-sepia-300 pt-4">
        <p class="font-koburi text-sm leading-7 text-sepia-600">結末には<br />触れません</p>
      </div>
      <div>
        <h2 id="synopsis-heading" class="fade-up font-koburi text-4xl leading-tight text-sepia-900 md:text-5xl">あらすじ</h2>
        <div class="mt-8 max-w-3xl space-y-6">
          {work.synopsis.map((paragraph) => (
            <p class="fade-up text-lg leading-9 text-sepia-800">{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-sepia-200/70 bg-sepia-50/55 py-20 md:py-28" aria-labelledby="guide-heading">
    <div class="mx-auto max-w-5xl px-6">
      <div class="max-w-2xl">
        <h2 id="guide-heading" class="fade-up font-koburi text-4xl text-sepia-900 md:text-5xl">読みどころ</h2>
      </div>
      <ol class="mt-14 border-t border-sepia-300">
        {work.readingPoints.map((point, index) => (
          <li class="fade-up grid gap-5 border-b border-sepia-300 py-9 md:grid-cols-[5rem_minmax(15rem,0.8fr)_minmax(0,1.2fr)] md:items-start">
            <span class="font-koburi text-3xl text-sepia-700">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="font-koburi text-2xl leading-9 text-sepia-900">{point.title}</h3>
            <p class="leading-8 text-sepia-700">{point.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 md:py-28" aria-labelledby="data-heading">
    <div class="mx-auto grid max-w-5xl gap-14 px-6 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.72fr)]">
      <div>
        <h2 id="data-heading" class="fade-up font-koburi text-4xl text-sepia-900 md:text-5xl">作品データ</h2>
        <dl class="mt-9 border-t border-sepia-300">
          {work.metadata.map((item) => (
            <div class="fade-up grid grid-cols-[7.5rem_1fr] gap-5 border-b border-sepia-200 py-4 text-sm leading-7">
              <dt class="text-sepia-700">{item.label}</dt>
              <dd class="text-sepia-800">{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <aside class="fade-up self-start border-l border-sepia-300 pl-7 lg:mt-20">
        <p class="font-koburi text-2xl text-sepia-900">青空文庫で読む</p>
        <p class="mt-5 leading-8 text-sepia-700">『{work.title}』の公開テキストは青空文庫で確認できます。このページには全文を掲載していません。</p>
        <div class="mt-8 flex flex-col items-start gap-4 text-sm">
          <a href={work.sources.textURL} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center border-b border-sepia-700 font-semibold text-sepia-800 hover:text-kotori-green">
            青空文庫で『{work.title}』を読む ↗
          </a>
          <a href={work.sources.cardURL} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sepia-600 underline decoration-sepia-300 underline-offset-4 hover:text-sepia-900">
            作品カードと底本情報 ↗
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="work-reading-cta overflow-hidden bg-sepia-50 text-sepia-900" aria-labelledby="kotori-reading-heading">
    <div class="mx-auto grid max-w-5xl gap-14 px-6 py-20 md:grid-cols-[minmax(0,1fr)_minmax(15rem,0.62fr)] md:items-center md:gap-16 md:py-24">
      <div class="relative z-10">
        <h2 id="kotori-reading-heading" class="fade-up max-w-xl font-koburi text-4xl leading-tight text-sepia-900 md:text-5xl">
          『{work.title}』を、縦書きで。
        </h2>
        <p class="fade-up mt-7 max-w-xl text-lg leading-9 text-sepia-700">広告も登録もなく、数ページずつ自分のペースで読み進められます。</p>

        <ul class="fade-up mt-8 flex flex-wrap text-sm font-semibold text-sepia-700" aria-label="コトリの特徴">
          <li class="mr-5 border-r border-sepia-500/60 pr-5">無料</li>
          <li class="mr-5 border-r border-sepia-500/60 pr-5">広告なし</li>
          <li>オフライン対応</li>
        </ul>

        <div class="fade-up mt-9">
          <AppStoreBadge variant="light" location="work_page" />
        </div>
      </div>

      <figure class="fade-up work-reading-cta__preview relative mx-auto w-full max-w-sm md:mx-0">
        <div class="absolute -inset-3 border border-sepia-400/25" aria-hidden="true"></div>
        <img
          src="/screenshots/screenshot-1-800-v1.webp"
          alt="コトリの縦書き読書画面"
          width="800"
          height="1739"
          loading="lazy"
          class="relative aspect-[4/5] w-full bg-sepia-50 object-cover object-top"
        />
      </figure>
    </div>
  </section>

  <section class="py-20 md:py-28" aria-labelledby="related-heading">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-10 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <div>
          <h2 id="related-heading" class="fade-up font-koburi text-4xl leading-tight text-sepia-900">{work.author}を<br />続けて読むなら</h2>
        </div>
        <div>
          <p class="fade-up max-w-2xl leading-8 text-sepia-700">{work.relatedIntro}</p>
          {(authorHub || collections.length > 0) && <div class="fade-up mt-7 flex flex-wrap gap-x-5 gap-y-3 text-sm">
            {authorHub && <a href={authorHubPath(authorHub)} class="text-sepia-800 underline decoration-sepia-300 underline-offset-4 hover:text-kotori-green">{authorHub.name}の作品案内を見る →</a>}
            {collections.map((collection) => <a href={`/collections/${collection.slug}/`} class="text-sepia-800 underline decoration-sepia-300 underline-offset-4 hover:text-kotori-green">「{collection.name}」を見る →</a>)}
          </div>}
          <ul class="mt-8 border-t border-sepia-300">
            {relatedWorks.map((related) => (
              <li class="fade-up flex items-baseline justify-between gap-5 border-b border-sepia-200 py-5">
                {related.path ? (
                  <a href={related.path} class="font-koburi text-2xl text-sepia-900 underline decoration-sepia-300 underline-offset-8 hover:text-kotori-green">『{related.title}』</a>
                ) : (
                  <span class="font-koburi text-2xl text-sepia-900">『{related.title}』</span>
                )}
                <span class="text-xs tracking-[0.12em] text-sepia-700">{related.bookID}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-sepia-200/70 py-20 md:py-28" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-4xl px-6">
      <h2 id="faq-heading" class="fade-up font-koburi text-4xl text-sepia-900">よくある質問</h2>
      <div class="mt-9 divide-y divide-sepia-300 border-y border-sepia-300">
        {work.faq.map((item) => (
          <div class="fade-up grid gap-4 py-7 md:grid-cols-[minmax(13rem,0.75fr)_minmax(0,1.25fr)]">
            <h3 class="font-koburi text-xl leading-8 text-sepia-900">{item.question}</h3>
            <p class="leading-8 text-sepia-700">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</article>

<style>
  .work-hero {
    background:
      radial-gradient(circle at 78% 18%, rgb(176 204 220 / 0.44), transparent 36%),
      var(--surface);
  }

  .work-reading-cta {
    background: var(--surface-alt);
  }

  .work-reading-cta__preview {
    transform: rotate(1.25deg);
  }

  @media (max-width: 767px) {
    .work-reading-cta__preview {
      transform: none;
    }
  }
</style>
