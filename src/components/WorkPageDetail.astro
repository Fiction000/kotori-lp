---
import AppStoreBadge from './AppStoreBadge.astro';
import type { WorkPage } from '../data/work-pages';

interface Props {
  work: WorkPage;
}

const { work } = Astro.props;
---

<article class="work-page">
  <section class="work-hero relative overflow-hidden border-b border-sepia-200/70">
    <div class="work-hero__title" aria-hidden="true">{work.title}</div>
    <div class="relative mx-auto max-w-6xl px-6 pb-20 pt-10 md:pb-28 md:pt-14">
      <nav aria-label="パンくず" class="fade-up flex flex-wrap items-center gap-2 text-xs text-sepia-600">
        <a href="/" class="rounded-sm hover:text-sepia-900">ホーム</a>
        <span aria-hidden="true">／</span>
        <a href="/works/" class="rounded-sm hover:text-sepia-900">作品案内</a>
        <span aria-hidden="true">／</span>
        <span aria-current="page">{work.title}</span>
      </nav>

      <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,0.82fr)_minmax(26rem,1.18fr)] lg:items-end">
        <div class="relative z-10">
          <p class="fade-up text-xs font-semibold tracking-[0.24em] text-sepia-600">AOZORA WORK · {work.bookID}</p>
          <h1 class="fade-up mt-5 font-koburi text-sepia-900">
            <span class="block text-[clamp(4.8rem,13vw,9.5rem)] leading-[0.86] tracking-[-0.06em]">{work.title}</span>
            <span class="mt-8 block text-xl font-normal tracking-[0.16em] text-sepia-700 md:text-2xl">{work.author}</span>
          </h1>
          <p class="fade-up mt-9 max-w-xl text-base leading-8 text-sepia-700 md:text-lg md:leading-9">{work.lead}</p>
        </div>

        <figure class="fade-up relative">
          <div class="absolute -left-4 -top-4 h-full w-full border border-sepia-300/70" aria-hidden="true"></div>
          <img
            src={work.image}
            alt={work.imageAlt}
            width="1536"
            height="1024"
            fetchpriority="high"
            class="relative aspect-[3/2] w-full bg-sepia-100 object-cover"
          />
          <figcaption class="mt-3 text-right text-[0.68rem] tracking-[0.12em] text-sepia-700">KOTORI EDITORIAL · {work.bookID}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28" aria-labelledby="synopsis-heading">
    <div class="mx-auto grid max-w-5xl gap-12 px-6 md:grid-cols-[10rem_minmax(0,1fr)]">
      <div class="fade-up border-t border-sepia-300 pt-4">
        <p class="font-koburi text-sm leading-7 text-sepia-600">結末には<br />触れません</p>
      </div>
      <div>
        <p class="fade-up text-xs font-semibold tracking-[0.22em] text-kotori-green">SYNOPSIS</p>
        <h2 id="synopsis-heading" class="fade-up mt-4 font-koburi text-4xl leading-tight text-sepia-900 md:text-5xl">あらすじ</h2>
        <div class="mt-9 max-w-3xl space-y-6">
          {work.synopsis.map((paragraph) => (
            <p class="fade-up text-lg leading-9 text-sepia-800">{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-sepia-200/70 bg-sepia-50/55 py-20 md:py-28" aria-labelledby="guide-heading">
    <div class="mx-auto max-w-5xl px-6">
      <div class="max-w-2xl">
        <p class="fade-up text-xs font-semibold tracking-[0.22em] text-kotori-green">READING GUIDE</p>
        <h2 id="guide-heading" class="fade-up mt-4 font-koburi text-4xl text-sepia-900 md:text-5xl">読みどころ</h2>
      </div>
      <ol class="mt-14 border-t border-sepia-300">
        {work.readingPoints.map((point, index) => (
          <li class="fade-up grid gap-5 border-b border-sepia-300 py-9 md:grid-cols-[5rem_minmax(15rem,0.8fr)_minmax(0,1.2fr)] md:items-start">
            <span class="font-koburi text-3xl text-sepia-700">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="font-koburi text-2xl leading-9 text-sepia-900">{point.title}</h3>
            <p class="leading-8 text-sepia-700">{point.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 md:py-28" aria-labelledby="data-heading">
    <div class="mx-auto grid max-w-5xl gap-14 px-6 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.72fr)]">
      <div>
        <p class="fade-up text-xs font-semibold tracking-[0.22em] text-kotori-green">BIBLIOGRAPHY</p>
        <h2 id="data-heading" class="fade-up mt-4 font-koburi text-4xl text-sepia-900 md:text-5xl">作品データ</h2>
        <dl class="mt-10 border-t border-sepia-300">
          {work.metadata.map((item) => (
            <div class="fade-up grid grid-cols-[7.5rem_1fr] gap-5 border-b border-sepia-200 py-4 text-sm leading-7">
              <dt class="text-sepia-700">{item.label}</dt>
              <dd class="text-sepia-800">{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <aside class="fade-up self-start border-l border-sepia-300 pl-7 lg:mt-20">
        <p class="font-koburi text-2xl text-sepia-900">青空文庫で読む</p>
        <p class="mt-5 leading-8 text-sepia-700">『こころ』の公開テキストは青空文庫で確認できます。このページには全文を掲載していません。</p>
        <div class="mt-8 flex flex-col items-start gap-4 text-sm">
          <a href={work.sources.textURL} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center border-b border-sepia-700 font-semibold text-sepia-800 hover:text-kotori-green">
            青空文庫で『こころ』を読む ↗
          </a>
          <a href={work.sources.cardURL} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sepia-600 underline decoration-sepia-300 underline-offset-4 hover:text-sepia-900">
            作品カードと底本情報 ↗
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-kotori-dark py-20 text-sepia-50 md:py-28" aria-labelledby="kotori-reading-heading">
    <div class="mx-auto grid max-w-5xl gap-12 px-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
      <div>
        <p class="fade-up text-xs font-semibold tracking-[0.22em] text-sepia-300">READ IN KOTORI</p>
        <h2 id="kotori-reading-heading" class="fade-up mt-4 font-koburi text-4xl md:text-5xl">コトリで読む</h2>
        <p class="fade-up mt-7 max-w-2xl text-lg leading-9 text-sepia-100">コトリなら、『こころ』を美しい縦書きで数ページずつ読み進められます。広告のない静かな空間で、作品に没入してみませんか。</p>
      </div>
      <div class="fade-up md:pb-1"><AppStoreBadge variant="light" /></div>
    </div>
  </section>

  <section class="py-20 md:py-28" aria-labelledby="related-heading">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-10 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <div>
          <p class="fade-up text-xs font-semibold tracking-[0.22em] text-kotori-green">READ NEXT</p>
          <h2 id="related-heading" class="fade-up mt-4 font-koburi text-4xl leading-tight text-sepia-900">夏目漱石を<br />続けて読むなら</h2>
        </div>
        <div>
          <p class="fade-up max-w-2xl leading-8 text-sepia-700">はじめて夏目漱石を読む順番としては、『坊っちゃん』の次に『こころ』を読むのがおすすめです。</p>
          <ul class="mt-8 border-t border-sepia-300">
            {work.relatedWorks.map((related) => (
              <li class="fade-up flex items-baseline justify-between gap-5 border-b border-sepia-200 py-5">
                <span class="font-koburi text-2xl text-sepia-900">『{related.title}』</span>
                <span class="text-xs tracking-[0.12em] text-sepia-700">{related.bookID}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-sepia-200/70 py-20 md:py-28" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-4xl px-6">
      <p class="fade-up text-xs font-semibold tracking-[0.22em] text-kotori-green">QUESTIONS</p>
      <h2 id="faq-heading" class="fade-up mt-4 font-koburi text-4xl text-sepia-900">よくある質問</h2>
      <div class="mt-10 divide-y divide-sepia-300 border-y border-sepia-300">
        {work.faq.map((item) => (
          <div class="fade-up grid gap-4 py-7 md:grid-cols-[minmax(13rem,0.75fr)_minmax(0,1.25fr)]">
            <h3 class="font-koburi text-xl leading-8 text-sepia-900">{item.question}</h3>
            <p class="leading-8 text-sepia-700">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</article>

<style>
  .work-hero {
    background:
      linear-gradient(90deg, transparent 0, transparent calc(50% - 0.5px), rgb(232 213 176 / 0.32) 50%, transparent calc(50% + 0.5px)),
      radial-gradient(circle at 78% 18%, rgb(232 213 176 / 0.52), transparent 36%);
  }

  .work-hero__title {
    position: absolute;
    right: clamp(1rem, 6vw, 6rem);
    top: 2.5rem;
    writing-mode: vertical-rl;
    font-family: var(--font-koburi);
    font-size: clamp(5rem, 12vw, 10rem);
    line-height: 1;
    letter-spacing: 0.08em;
    color: rgb(232 213 176 / 0.42);
    user-select: none;
  }

  @media (max-width: 767px) {
    .work-hero__title {
      right: -0.6rem;
      top: 5rem;
      font-size: 7rem;
      opacity: 0.7;
    }
  }
</style>
