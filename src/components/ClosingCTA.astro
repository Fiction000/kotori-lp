---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import AppStoreBadge from './AppStoreBadge.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative overflow-hidden py-28 md:py-40">
  <!-- Background tategaki accent -->
  <div class="absolute inset-0 select-none pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute left-[8%] top-0 font-koburi text-sepia-100 writing-vertical text-[4rem] md:text-[6rem] leading-loose whitespace-nowrap h-full">
      春はあけぼの。
    </div>
    <div class="absolute right-[10%] top-8 font-koburi text-sepia-100 writing-vertical text-[3rem] md:text-[5rem] leading-loose whitespace-nowrap h-full">
      月日は百代の過客にして、
    </div>
  </div>

  <div class="relative mx-auto max-w-3xl px-6 text-center">
    <p class="fade-up font-koburi text-2xl md:text-3xl text-sepia-700 leading-relaxed mb-4">
      {lang === 'ja'
        ? '日本文学の名作を、あなたの手のひらに。'
        : 'Japanese literary classics, in the palm of your hand.'}
    </p>
    <p class="fade-up text-sepia-400 text-base md:text-lg mb-12">
      {lang === 'ja'
        ? '無料・広告なし・オフライン対応'
        : 'Free, no ads, works offline'}
    </p>
    <div class="fade-up">
      <AppStoreBadge />
    </div>
  </div>
</section>

<style>
  .writing-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
</style>
