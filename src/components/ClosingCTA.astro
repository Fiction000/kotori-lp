---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import DownloadCTA from './shared/DownloadCTA.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<DownloadCTA
  lang={lang}
  variant="closing"
  location="closing_cta"
  title={lang === 'ja'
    ? '日本文学の名作を、あなたの手のひらに。'
    : 'Japanese literary classics, in the palm of your hand.'}
  body={lang === 'ja'
    ? '無料・広告なし・オフライン対応'
    : 'Free, no ads, works offline'}
/>
