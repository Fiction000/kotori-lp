---
import { getLangFromUrl } from '../i18n/utils';
import AppStoreBadge from './AppStoreBadge.astro';

const lang = getLangFromUrl(Astro.url);
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <p class="fade-up font-koburi text-2xl md:text-3xl text-sepia-700 leading-relaxed mb-4">
      {lang === 'ja'
        ? '日本文学の名作を、あなたの手のひらに。'
        : 'Japanese literary classics, in the palm of your hand.'}
    </p>
    <p class="fade-up mb-8 text-base text-sepia-700 md:text-lg">
      {lang === 'ja'
        ? '無料・広告なし・オフライン対応'
        : 'Free, no ads, works offline'}
    </p>
    <div class="fade-up">
      <AppStoreBadge location="closing_cta" />
    </div>
  </div>
</section>
