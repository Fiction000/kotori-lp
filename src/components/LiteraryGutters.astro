---
import { readyPicks } from '../data/editorial';

type LiteraryExcerpt = {
  id: string;
  text: string;
  side: 'left' | 'right';
  top: string;
  offset: string;
  size: string;
  mobileSize: string;
  opacity: string;
  length: string;
  leading: string;
  tracking: string;
  mobile?: boolean;
  source: string;
};

const editorialSources = new Map(readyPicks().map((pick) => [pick.id, pick.source.cardURL]));
const historicalSource = 'Aozora Bunko passage retained from the pre-d27815d Hero';
const sourceFor = (id: string) => editorialSources.get(id) ?? historicalSource;

// This is intentionally the old Hero's scattered writing wall, adapted to
// the much taller Features section. The four works in the current editorial
// manifest provide live Aozora Bunko source metadata; the other passages are
// reused from that earlier implementation. Works with uncertain 2026 rights
// status are deliberately not included here. Each fragment ends at Japanese
// punctuation so the fixed visual lengths never cut through its meaning.
const excerpts: LiteraryExcerpt[] = [
  {
    id: 'wagahai',
    text: '吾輩は猫である。名前はまだ無い。',
    side: 'left', top: '-2%', offset: '0%', size: '1.85rem', mobileSize: '0.96rem', opacity: '0.38', length: '40rem', leading: '1.7', tracking: '0.04em', mobile: true, source: historicalSource,
  },
  {
    id: 'rashomon',
    text: '一人の下人が、羅生門の下で雨やみを待っていた。',
    side: 'left', top: '7%', offset: '29%', size: '0.92rem', mobileSize: '0.82rem', opacity: '0.34', length: '25rem', leading: '1.95', tracking: '0.08em', mobile: true, source: sourceFor('rashomon'),
  },
  {
    id: 'melos',
    text: 'メロスは激怒した。',
    side: 'left', top: '14%', offset: '55%', size: '2.15rem', mobileSize: '1.02rem', opacity: '0.32', length: '48rem', leading: '1.5', tracking: '0.02em', mobile: true, source: historicalSource,
  },
  {
    id: 'ningen-shikkaku',
    text: '恥の多い生涯を送って来ました。',
    side: 'left', top: '22%', offset: '12%', size: '1.45rem', mobileSize: '0.88rem', opacity: '0.28', length: '35rem', leading: '1.8', tracking: '0.05em', source: historicalSource,
  },
  {
    id: 'botchan',
    text: '親譲りの無鉄砲で小供の時から損ばかりしている。',
    side: 'left', top: '31%', offset: '72%', size: '1.28rem', mobileSize: '0.82rem', opacity: '0.31', length: '31rem', leading: '1.85', tracking: '0.05em', source: historicalSource,
  },
  {
    id: 'kumo-no-ito',
    text: '或日の事でございます。',
    side: 'left', top: '40%', offset: '36%', size: '1.06rem', mobileSize: '0.78rem', opacity: '0.27', length: '23rem', leading: '2.05', tracking: '0.09em', source: historicalSource,
  },
  {
    id: 'yoake-mae',
    text: '木曾路はすべて山の中である。',
    side: 'left', top: '49%', offset: '3%', size: '1.72rem', mobileSize: '0.98rem', opacity: '0.31', length: '56rem', leading: '1.65', tracking: '0.04em', source: historicalSource,
  },
  {
    id: 'mai-hime',
    text: '石炭をば早や積み果てつ。',
    side: 'left', top: '59%', offset: '62%', size: '1.42rem', mobileSize: '0.86rem', opacity: '0.25', length: '36rem', leading: '1.75', tracking: '0.05em', source: historicalSource,
  },
  {
    id: 'gion-shoja',
    text: '祇園精舎の鐘の声、諸行無常の響きあり。',
    side: 'left', top: '68%', offset: '22%', size: '0.78rem', mobileSize: '0.76rem', opacity: '0.26', length: '21rem', leading: '2.15', tracking: '0.1em', source: historicalSource,
  },
  {
    id: 'haru-wa-akebono',
    text: '春はあけぼの。やうやう白くなりゆく山際、',
    side: 'left', top: '76%', offset: '80%', size: '1.26rem', mobileSize: '0.84rem', opacity: '0.23', length: '35rem', leading: '1.9', tracking: '0.06em', mobile: true, source: historicalSource,
  },
  {
    id: 'tsurezuregusa',
    text: 'つれづれなるままに、日くらし硯にむかひて、',
    side: 'left', top: '85%', offset: '46%', size: '1.04rem', mobileSize: '0.78rem', opacity: '0.24', length: '27rem', leading: '2', tracking: '0.08em', source: historicalSource,
  },
  {
    id: 'oku-no-hosomichi',
    text: '月日は百代の過客にして、',
    side: 'left', top: '93%', offset: '8%', size: '1.92rem', mobileSize: '0.92rem', opacity: '0.36', length: '44rem', leading: '1.6', tracking: '0.03em', source: historicalSource,
  },
  {
    id: 'river',
    text: '行く川のながれは絶えずして、',
    side: 'right', top: '2%', offset: '68%', size: '1.24rem', mobileSize: '0.8rem', opacity: '0.25', length: '32rem', leading: '1.9', tracking: '0.06em', source: historicalSource,
  },
  {
    id: 'ise-monogatari',
    text: '昔、男ありけり。',
    side: 'right', top: '10%', offset: '22%', size: '0.86rem', mobileSize: '0.76rem', opacity: '0.23', length: '24rem', leading: '2.1', tracking: '0.1em', source: historicalSource,
  },
  {
    id: 'ginga-tetsudo',
    text: 'カムパネルラが手をあげました。',
    side: 'right', top: '18%', offset: '57%', size: '1.66rem', mobileSize: '0.98rem', opacity: '0.36', length: '47rem', leading: '1.55', tracking: '0.03em', mobile: true, source: sourceFor('ginga-tetsudo-no-yoru'),
  },
  {
    id: 'kusamakura',
    text: '山路を登りながら、こう考えた。',
    side: 'right', top: '27%', offset: '5%', size: '1.98rem', mobileSize: '0.94rem', opacity: '0.34', length: '51rem', leading: '1.5', tracking: '0.02em', source: historicalSource,
  },
  {
    id: 'lemon',
    text: 'えたいの知れない不吉な塊が、',
    side: 'right', top: '37%', offset: '76%', size: '1.38rem', mobileSize: '0.9rem', opacity: '0.34', length: '34rem', leading: '1.75', tracking: '0.05em', mobile: true, source: sourceFor('lemon'),
  },
  {
    id: 'takekurabe',
    text: '廻れば大門の見返り柳いと長けれど、',
    side: 'right', top: '45%', offset: '38%', size: '2.12rem', mobileSize: '0.98rem', opacity: '0.38', length: '43rem', leading: '1.45', tracking: '0.01em', source: historicalSource,
  },
  {
    id: 'kokoro',
    text: '私はその人を常に先生と呼んでいた。だからここでも、',
    side: 'right', top: '53%', offset: '7%', size: '1.22rem', mobileSize: '0.88rem', opacity: '0.35', length: '38rem', leading: '1.85', tracking: '0.05em', mobile: true, source: sourceFor('kokoro'),
  },
  {
    id: 'sakura-no-ki',
    text: '桜の樹の下には屍体が埋まっている！',
    side: 'right', top: '62%', offset: '66%', size: '1.58rem', mobileSize: '0.9rem', opacity: '0.34', length: '36rem', leading: '1.7', tracking: '0.04em', source: historicalSource,
  },
  {
    id: 'mikan',
    text: '或秋の日暮です。',
    side: 'right', top: '71%', offset: '30%', size: '1.02rem', mobileSize: '0.8rem', opacity: '0.28', length: '25rem', leading: '2', tracking: '0.08em', mobile: true, source: historicalSource,
  },
  {
    id: 'sangetsuki',
    text: '隴西の李徴は博学才穎、天宝の末年、',
    side: 'right', top: '79%', offset: '83%', size: '1.82rem', mobileSize: '0.9rem', opacity: '0.32', length: '43rem', leading: '1.6', tracking: '0.03em', source: historicalSource,
  },
  {
    id: 'nekomata',
    text: '奥山に猫又といふものありて、',
    side: 'right', top: '88%', offset: '47%', size: '1.32rem', mobileSize: '0.84rem', opacity: '0.3', length: '37rem', leading: '1.8', tracking: '0.06em', source: historicalSource,
  },
  {
    id: 'aozora-morning',
    text: '或る朝の事、彼は明け方から、',
    side: 'right', top: '96%', offset: '12%', size: '1.56rem', mobileSize: '0.82rem', opacity: '0.29', length: '28rem', leading: '1.75', tracking: '0.05em', source: sourceFor('ginga-tetsudo-no-yoru'),
  },
];

const leftExcerpts = excerpts.filter((excerpt) => excerpt.side === 'left');
const rightExcerpts = excerpts.filter((excerpt) => excerpt.side === 'right');

const streamStyle = (excerpt: LiteraryExcerpt) => `--top: ${excerpt.top}; --offset: ${excerpt.offset}; --size: ${excerpt.size}; --mobile-size: ${excerpt.mobileSize}; --opacity: ${excerpt.opacity}; --length: ${excerpt.length}; --leading: ${excerpt.leading}; --tracking: ${excerpt.tracking};`;
---

<div class="literary-gutters" aria-hidden="true">
  <div class="literary-field literary-field--left">
    {leftExcerpts.map((excerpt) => (
      <div
        class="literary-stream"
        data-mobile={excerpt.mobile ? 'true' : 'false'}
        data-source={excerpt.source}
        data-excerpt={excerpt.text}
        lang="ja"
        style={streamStyle(excerpt)}
      ></div>
    ))}
  </div>

  <div class="literary-field literary-field--right">
    {rightExcerpts.map((excerpt) => (
      <div
        class="literary-stream"
        data-mobile={excerpt.mobile ? 'true' : 'false'}
        data-source={excerpt.source}
        data-excerpt={excerpt.text}
        lang="ja"
        style={streamStyle(excerpt)}
      ></div>
    ))}
  </div>
</div>

<style>
  .literary-gutters {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    overflow: hidden;
    pointer-events: none;
  }

  .literary-field {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.7rem;
    overflow: hidden;
  }

  .literary-field--left {
    left: 0;
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 42%, transparent 100%);
    mask-image: linear-gradient(to right, #000 0%, #000 42%, transparent 100%);
  }

  .literary-field--right {
    right: 0;
    -webkit-mask-image: linear-gradient(to left, #000 0%, #000 42%, transparent 100%);
    mask-image: linear-gradient(to left, #000 0%, #000 42%, transparent 100%);
  }

  .literary-stream {
    display: none;
    position: absolute;
    top: var(--top);
    left: var(--offset);
    width: 2rem;
    height: var(--length);
    overflow: hidden;
    color: rgba(20, 47, 67, 0.94);
    font-family: var(--font-koburi);
    font-size: var(--mobile-size);
    font-weight: 400;
    letter-spacing: var(--tracking);
    line-height: var(--leading);
    opacity: var(--opacity);
    text-orientation: mixed;
    writing-mode: vertical-rl;
    white-space: nowrap;
  }

  .literary-stream[data-mobile='true'] {
    display: block;
  }

  .literary-stream::before {
    display: block;
    content: attr(data-excerpt);
  }

  /* Keep the full wall at a quieter scale between mobile and wide desktop. */
  @media (min-width: 768px) and (max-width: 1279px) {
    .literary-field {
      width: 3.25rem;
    }

    .literary-stream {
      display: block;
      font-size: min(var(--size), 1.1rem);
      opacity: calc(var(--opacity) * 0.86);
    }
  }

  @media (min-width: 1280px) {
    .literary-field {
      width: calc((100vw - 72rem) / 2);
    }

    .literary-stream {
      display: block;
      font-size: var(--size);
    }
  }

  @media (max-width: 374px) {
    .literary-field {
      width: 2.35rem;
    }

    .literary-stream {
      width: 1.7rem;
      font-size: min(var(--mobile-size), 0.88rem);
    }
  }
</style>
