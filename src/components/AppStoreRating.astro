---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="flex items-center justify-center gap-2.5" role="img" aria-label={t('appStore.ratingLabel')}>
  <span class="relative inline-block whitespace-nowrap text-sm leading-none tracking-[0.1em] text-sepia-300" aria-hidden="true">
    ★★★★★
    <span class="absolute inset-0 block w-[92%] overflow-hidden whitespace-nowrap text-sepia-500">★★★★★</span>
  </span>
  <span class="font-koburi text-sm tabular-nums text-sepia-600">4.6 / 5</span>
  <span class="text-[0.68rem] tracking-[0.06em] text-sepia-600">{t('appStore.ratingSource')}</span>
</div>
