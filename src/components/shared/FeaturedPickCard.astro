---
import type { DiscoveryBook, SharedLocale } from './discovery-types';

interface Props extends DiscoveryBook {
  lang?: SharedLocale;
  eyebrow?: string;
  ctaLabel?: string;
}

const {
  title, author, href, summary, image, imageAlt = '', meta,
  lang = 'ja', eyebrow = lang === 'ja' ? 'FEATURED PICK' : 'FEATURED PICK',
  ctaLabel = lang === 'ja' ? '紹介を読む' : 'Read the introduction',
} = Astro.props;
---

<article class="featured-pick" lang={lang}>
  <a href={href} class="featured-pick__link group">
    <div class="featured-pick__content">
      <p class="featured-pick__eyebrow">{eyebrow}</p>
      {meta && <p class="featured-pick__meta">{meta}</p>}
      <h2 class="featured-pick__title">{title}</h2>
      <p class="featured-pick__author">{author}</p>
      {summary && <p class="featured-pick__summary">{summary}</p>}
      <span class="featured-pick__action" aria-hidden="true">{ctaLabel} →</span>
    </div>
    {image && <img src={image} alt={imageAlt} width="1536" height="1024" class="featured-pick__image" />}
  </a>
</article>

<style>
  .featured-pick__link { display: grid; overflow: hidden; border: 1px solid var(--color-sepia-300); background: var(--color-sepia-50); color: inherit; text-decoration: none; }
  .featured-pick__content { display: flex; min-width: 0; flex-direction: column; padding: 1.5rem; }
  .featured-pick__eyebrow, .featured-pick__meta { margin: 0; color: var(--color-sepia-600); font-size: .7rem; font-weight: 600; letter-spacing: .17em; }
  .featured-pick__meta { margin-top: 1rem; letter-spacing: .1em; }
  .featured-pick__title { margin: .8rem 0 0; color: var(--color-sepia-900); font-family: var(--font-koburi); font-size: clamp(2rem, 7vw, 3.5rem); line-height: 1.1; overflow-wrap: anywhere; }
  .featured-pick__author { margin: .8rem 0 0; color: var(--color-sepia-700); }
  .featured-pick__summary { margin: 1.25rem 0 0; color: var(--color-sepia-700); line-height: 1.8; }
  .featured-pick__action { margin-top: 1.5rem; color: var(--color-sepia-800); font-size: .875rem; font-weight: 600; }
  .featured-pick__image { order: -1; aspect-ratio: 3 / 2; width: 100%; border-bottom: 1px solid var(--color-sepia-200); background: var(--color-sepia-100); object-fit: cover; }
  .featured-pick__link:hover .featured-pick__action { color: var(--color-kotori-green); }
  @media (min-width: 48rem) { .featured-pick__link { grid-template-columns: minmax(0, 1fr) minmax(15rem, .9fr); } .featured-pick__content { padding: 2.25rem; } .featured-pick__image { order: initial; height: 100%; border-bottom: 0; border-left: 1px solid var(--color-sepia-200); } }
</style>
