---
import type { SharedLocale } from './discovery-types';

interface Props {
  title: string;
  lang?: SharedLocale;
  eyebrow?: string;
  summary?: string;
  author?: string;
  backHref?: string;
  backLabel?: string;
  titleSize?: 'standard' | 'display';
}

const {
  title,
  lang = 'ja',
  eyebrow,
  summary,
  author,
  backHref,
  backLabel = lang === 'ja' ? '一覧へ戻る' : 'Back to index',
  titleSize = 'display',
} = Astro.props;
---

<header class:list={['article-header', `article-header--${titleSize}`]} lang={lang}>
  {backHref && <a href={backHref} class="article-header__back">← {backLabel}</a>}
  <div class="article-header__layout">
    <div class="article-header__main">
      {eyebrow && <p class="article-header__eyebrow">{eyebrow}</p>}
      <h1 class="article-header__title">{title}</h1>
      {author && <p class="article-header__author">{author}</p>}
      {summary && <p class="article-header__summary">{summary}</p>}
      {Astro.slots.has('after') && <div class="article-header__after"><slot name="after" /></div>}
    </div>
    {Astro.slots.has('media') && <figure class="article-header__media"><slot name="media" /></figure>}
  </div>
</header>

<style>
  .article-header { border-bottom: 1px solid rgb(232 213 176 / .7); padding-block: clamp(3.5rem, 10vw, 7rem); }
  .article-header__back { display: inline-flex; min-height: 2.75rem; align-items: center; color: var(--color-sepia-700); font-size: .875rem; text-decoration: none; }
  .article-header__back:hover { color: var(--color-kotori-green); }
  .article-header__layout { display: grid; gap: 2.5rem; margin-top: 2rem; }
  .article-header__eyebrow { margin: 0; color: var(--color-kotori-green); font-size: .7rem; font-weight: 700; letter-spacing: .2em; }
  .article-header__title { margin: 1rem 0 0; max-width: 11ch; color: var(--color-sepia-900); font-family: var(--font-koburi); font-size: clamp(3rem, 10vw, 6.5rem); line-height: .98; letter-spacing: -.045em; overflow-wrap: anywhere; }
  .article-header--standard .article-header__title { font-size: clamp(2.6rem, 8vw, 4.5rem); line-height: 1.1; }
  .article-header__author { margin: 1rem 0 0; color: var(--color-sepia-700); font-family: var(--font-koburi); font-size: clamp(1.1rem, 3vw, 1.45rem); letter-spacing: .08em; }
  .article-header__summary { margin: 1.5rem 0 0; max-width: 43rem; color: var(--color-sepia-700); font-size: clamp(1rem, 2.6vw, 1.15rem); line-height: 1.9; }
  .article-header__after { margin-top: 1.5rem; }
  .article-header__media { margin: 0; overflow: hidden; border: 1px solid var(--color-sepia-200); background: var(--color-sepia-100); }
  .article-header__media :global(img) { display: block; aspect-ratio: 3 / 2; width: 100%; object-fit: cover; }
  @media (min-width: 48rem) { .article-header__layout { grid-template-columns: minmax(0, 1fr) minmax(16rem, .72fr); align-items: end; gap: 4rem; } .article-header__layout:not(:has(.article-header__media)) { grid-template-columns: minmax(0, 1fr); } }
</style>
