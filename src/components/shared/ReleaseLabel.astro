---
import { getLangFromUrl, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  version: string;
  releasedAt: string;
  lang?: Lang;
  isLatest?: boolean;
  latestLabel?: string;
}

const { version, releasedAt, isLatest = false, latestLabel } = Astro.props;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const resolvedLatestLabel = latestLabel ?? t('changelog.latest');
const dateFormatter = new Intl.DateTimeFormat(lang === 'ja' ? 'ja-JP' : 'en-US', {
  year: 'numeric',
  month: lang === 'ja' ? 'numeric' : 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<div lang={lang}>
  <p class="font-koburi text-2xl text-kotori-green">v{version}</p>
  <time datetime={releasedAt} class="mt-2 block text-sm tabular-nums text-sepia-600">
    {dateFormatter.format(new Date(`${releasedAt}T00:00:00Z`))}
  </time>
  {isLatest && (
    <span class="mt-5 inline-flex rounded-full border border-sepia-300 px-3 py-1 text-xs font-medium text-sepia-700">
      {resolvedLatestLabel}
    </span>
  )}
</div>
