---
import DownloadAction from './DownloadAction.astro';
import { getLangFromUrl, type Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
  variant?: 'compact' | 'closing' | 'book';
  title?: string;
  body?: string;
  bookTitle?: string;
  location?: string;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const variant = Astro.props.variant ?? 'compact';
const title = Astro.props.title ?? (lang === 'ja'
  ? '日本文学の名作を、あなたの手のひらに。'
  : 'Japanese literary classics, in the palm of your hand.');
const body = Astro.props.body ?? (lang === 'ja'
  ? '無料・広告なし・オフライン対応'
  : 'Free, no ads, works offline');
const bookTitle = Astro.props.bookTitle;
const location = Astro.props.location ?? `download_cta_${variant}`;
---

{variant === 'closing' ? (
  <section class="relative overflow-hidden py-28 md:py-40">
    <div class="pointer-events-none absolute inset-0 hidden select-none overflow-hidden md:block" aria-hidden="true">
      <div class="absolute left-[8%] top-0 h-full whitespace-nowrap font-koburi text-[6rem] leading-loose text-kotori-dark/20 writing-vertical">春はあけぼの。</div>
      <div class="absolute right-[10%] top-8 h-full whitespace-nowrap font-koburi text-[5rem] leading-loose text-kotori-dark/20 writing-vertical">月日は百代の過客にして、</div>
    </div>
    <div class="relative mx-auto max-w-3xl px-6 text-center">
      <p class="fade-up cta-title mb-4 font-koburi text-2xl leading-relaxed text-sepia-700 md:text-3xl">{title}</p>
      <p class="fade-up mb-12 text-base text-sepia-700 md:text-lg">{body}</p>
      <div class="fade-up"><DownloadAction lang={lang} location={location} /></div>
    </div>
  </section>
) : (
  <section class:list={[
    'rounded-xl border border-sepia-200/80 bg-white/60 p-6 md:p-8',
    variant === 'book' && 'bg-sepia-50/70',
  ]}>
    {bookTitle && <p class="book-title mb-3 font-koburi text-lg leading-8 text-kotori-green">『{bookTitle}』</p>}
    <h2 class="cta-title font-koburi text-2xl leading-snug text-sepia-900 md:text-3xl">{title}</h2>
    <p class="mt-3 max-w-2xl leading-7 text-sepia-700">{body}</p>
    <div class="mt-6"><DownloadAction lang={lang} location={location} variant="light" /></div>
  </section>
)}

<style>
  .writing-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .cta-title,
  .book-title {
    overflow-wrap: anywhere;
  }
</style>
