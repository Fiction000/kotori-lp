---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { editorialDetailPath, editorialManifest, localizedPick, weeklyPick, type EditorialLocale } from '../data/editorial';
import AppStoreBadge from './AppStoreBadge.astro';
import AppStoreRating from './AppStoreRating.astro';

const lang = getLangFromUrl(Astro.url) as EditorialLocale;
const t = useTranslations(lang);
const pick = localizedPick(weeklyPick(), lang);
const weeklyPath = editorialDetailPath(pick.id, lang);
const clientPicks = editorialManifest.rotation.pickIDs
  .map((id) => editorialManifest.picks.find((candidate) => candidate.id === id))
  .filter((candidate): candidate is NonNullable<typeof candidate> => candidate?.status === 'ready')
  .map((candidate) => {
    const content = localizedPick(candidate, lang);
    return { id: content.id, title: content.title, author: content.author, whyNow: content.whyNow };
  });
const rotation = editorialManifest.rotation;
---

<section class="hero-shell" aria-labelledby="hero-title">
  <div class="hero-layout mx-auto max-w-7xl px-6">
    <div class="hero-copy fade-up">
      <h1 id="hero-title" class="hero-title">
        <span>{t('hero.tagline.lead')}</span>
        <span class="hero-title__emphasis">
          {t('hero.tagline.emphasis.lead')}
          {lang === 'ja' && <><wbr />{t('hero.tagline.emphasis.tail')}</>}
        </span>
      </h1>

      <p class="hero-description">{t('hero.description')}</p>

      <ul class="hero-assurances" aria-label={lang === 'ja' ? '利用条件' : 'At a glance'}>
        <li>{t('hero.free')}</li>
        <li>{t('hero.noAccount')}</li>
        <li>{t('hero.offline')}</li>
      </ul>

      <div class="hero-actions">
        <AppStoreBadge location="hero" />
        <AppStoreRating />
      </div>
    </div>

    <div class="hero-product fade-up">
      <div class="reader-window">
        <img
          src="/screenshots/screenshot-1-800-v1.webp"
          srcset="/screenshots/screenshot-1-480-v1.webp 480w, /screenshots/screenshot-1-800-v1.webp 800w"
          sizes="(min-width: 960px) 216px, (min-width: 561px) 240px, 60vw"
          alt={t('hero.screenshotAlt')}
          width="800"
          height="1739"
          class="reader-window__screen"
          fetchpriority="high"
        />
      </div>

      <a id="weekly-hero-card" href={weeklyPath} class="weekly-card group">
        <div class="weekly-card__topline">
          <span class="weekly-card__bird" aria-hidden="true">●</span>
          <span>{t('hero.weekly.label')}</span>
        </div>
        <p id="weekly-hero-title" class="weekly-card__title font-koburi">{pick.title}</p>
        <p id="weekly-hero-author" class="weekly-card__author">{pick.author}</p>
        <p id="weekly-hero-reason" class="weekly-card__reason">{pick.whyNow}</p>
        <span class="weekly-card__link">
          {t('hero.weekly.link')}
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </div>
</section>

<script define:vars={{ clientPicks, rotation, lang }}>
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit',
  }).formatToParts(new Date());
  const part = (type) => Number(parts.find((item) => item.type === type)?.value);
  const serialDay = (year, month, day) => Math.floor(Date.UTC(year, month - 1, day) / 86400000);
  const [anchorYear, anchorMonth, anchorDay] = rotation.effectiveFrom.split('-').map(Number);
  const currentDay = serialDay(part('year'), part('month'), part('day'));
  const weekStart = currentDay - ((currentDay + 3) % 7);
  const elapsedWeeks = Math.floor((weekStart - serialDay(anchorYear, anchorMonth, anchorDay)) / 7);
  const index = ((elapsedWeeks % clientPicks.length) + clientPicks.length) % clientPicks.length;
  const current = clientPicks[index];
  const card = document.getElementById('weekly-hero-card');
  const title = document.getElementById('weekly-hero-title');
  const author = document.getElementById('weekly-hero-author');
  const reason = document.getElementById('weekly-hero-reason');
  if (card instanceof HTMLAnchorElement) {
    card.href = lang === 'ja' && current.id === 'kokoro'
      ? '/works/000773/kokoro/'
      : `${lang === 'en' ? '/en' : ''}/weekly/${current.id}/`;
  }
  if (title) title.textContent = current.title;
  if (author) author.textContent = current.author;
  if (reason) reason.textContent = current.whyNow;
</script>

<style>
  .hero-shell {
    border-bottom: 1px solid rgba(25, 58, 88, 0.12);
    background: #fbfaf6;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5.5rem);
    padding-top: clamp(2.25rem, 3.5vw, 4rem);
    padding-bottom: clamp(2.25rem, 3.5vw, 4rem);
  }

  .hero-copy {
    min-width: 0;
    max-width: 40rem;
  }

  .hero-title {
    color: #142f43;
    font-size: clamp(2.65rem, 5.15vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.16;
  }

  .hero-title span {
    display: block;
    word-break: keep-all;
  }

  .hero-title__emphasis {
    color: #176b9b;
  }

  .hero-description {
    max-width: 36rem;
    margin-top: 1.4rem;
    color: #395164;
    font-size: clamp(1rem, 1.6vw, 1.16rem);
    line-height: 1.9;
  }

  .hero-assurances {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .hero-assurances li {
    position: relative;
    padding-left: 0.85rem;
    color: #29495f;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .hero-assurances li::before {
    position: absolute;
    top: 0.58em;
    left: 0;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: #4c8aaa;
    content: '';
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 1.65rem;
  }

  .hero-product {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.2vw, 1.75rem);
    width: min(100%, 33rem);
    margin-inline: auto;
  }

  .reader-window {
    flex: 0 1 13.5rem;
    overflow: hidden;
    border-radius: 0.85rem;
    background: #fff;
    box-shadow:
      0 20px 46px rgba(19, 63, 92, 0.13),
      0 3px 8px rgba(19, 63, 92, 0.07);
  }

  .reader-window__screen {
    display: block;
    width: 100%;
    aspect-ratio: 0.64;
    object-fit: cover;
    object-position: top;
  }

  .weekly-card {
    order: -1;
    flex: 1 1 14.5rem;
    max-width: 17.5rem;
    border: 1px solid rgba(20, 47, 67, 0.15);
    border-radius: 0.75rem;
    background: #f5f0e6;
    padding: 1.25rem;
    color: #142f43;
    transition: background-color 200ms ease;
  }

  .weekly-card:hover {
    background: #f5ead6;
  }

  .weekly-card__topline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #765348;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.16em;
  }

  .weekly-card__bird {
    font-size: 0.5rem;
  }

  .weekly-card__title {
    margin-top: 0.7rem;
    font-size: 1.75rem;
    line-height: 1.35;
  }

  .weekly-card__author {
    margin-top: 0.15rem;
    color: #5b6b75;
    font-size: 0.78rem;
  }

  .weekly-card__reason {
    margin-top: 0.75rem;
    color: #405968;
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .weekly-card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(20, 47, 67, 0.12);
    color: #176b9b;
    font-size: 0.78rem;
    font-weight: 700;
  }

  @media (min-width: 960px) {
    .hero-layout {
      grid-template-columns: minmax(0, 1.08fr) minmax(27rem, 0.92fr);
    }
  }

  @media (max-width: 959px) {
    .hero-layout {
      gap: 3.5rem;
    }

    .hero-copy {
      margin-inline: auto;
      text-align: center;
    }

    .hero-actions,
    .hero-assurances {
      justify-content: center;
    }
  }

  @media (min-width: 960px) and (max-height: 700px) {
    .hero-layout {
      padding-block: 1.5rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 3.4vw, 3rem);
    }

    .hero-description {
      margin-top: 1.1rem;
      font-size: 1rem;
      line-height: 1.7;
    }

    .hero-assurances,
    .hero-actions {
      margin-top: 1rem;
    }
  }

  @media (max-width: 560px) {
    .hero-title {
      font-size: clamp(1.75rem, 8.6vw, 2.45rem);
    }

    .hero-title span {
      word-break: normal;
      letter-spacing: -0.04em;
    }

    .hero-description {
      line-height: 1.75;
    }

    .hero-product {
      align-items: stretch;
      flex-direction: column;
      width: min(100%, 25rem);
      gap: 1.5rem;
    }

    .reader-window {
      flex: none;
      width: min(68%, 15rem);
      margin-inline: auto;
    }

    .weekly-card {
      order: initial;
      width: 100%;
      max-width: none;
      padding: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weekly-card {
      transition: none;
    }
  }
</style>
