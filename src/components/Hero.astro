---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { EditorialLocale } from '../data/editorial';
import AppStoreBadge from './AppStoreBadge.astro';
import AppStoreRating from './AppStoreRating.astro';
import FeaturedPick from './FeaturedPick.astro';

const lang = getLangFromUrl(Astro.url) as EditorialLocale;
const t = useTranslations(lang);
---

<section class="hero-shell" aria-labelledby="hero-title">
  <div class="hero-layout mx-auto max-w-7xl px-6 pb-24 pt-16 md:pb-32 md:pt-24">
    <div class="hero-copy">
      <div class="hero-eyebrow">
        <img
          src="/app-icon-288-v1.webp"
          alt=""
          width="36"
          height="36"
          class="hero-mark"
        />
        <p>{t('hero.eyebrow')}</p>
      </div>

      <h1 id="hero-title" class="hero-title">
        <span>{t('hero.tagline.lead')}</span>
        <span class="hero-title__emphasis">
          {t('hero.tagline.emphasis.lead')}
          {lang === 'ja' && <><wbr />{t('hero.tagline.emphasis.tail')}</>}
        </span>
      </h1>

      <p class="hero-description">{t('hero.description')}</p>


      <div class="hero-actions">
        <AppStoreBadge location="hero" />

      </div>
    </div>

    <div class="hero-product">
      <div class="reader-window">
        <img
          src="/screenshots/screenshot-1-800-v1.webp"
          srcset="/screenshots/screenshot-1-480-v1.webp 480w, /screenshots/screenshot-1-800-v1.webp 800w"
          sizes="(min-width: 1024px) 400px, 78vw"
          alt={t('hero.screenshotAlt')}
          width="800"
          height="1739"
          class="reader-window__screen"
          fetchpriority="high"
        />
      </div>

      <div class="hero-weekly-pick">
        <FeaturedPick />
      </div>
    </div>
  </div>
</section>
<div class="hero-reassurance-band mx-auto max-w-7xl px-6">
      <ul class="hero-assurances" aria-label={lang === 'ja' ? '利用条件' : 'At a glance'}>
        <li>{t('hero.free')}</li>
        <li>{t('hero.noAccount')}</li>
        <li>{t('hero.offline')}</li>
      </ul>
  <AppStoreRating />
</div>

<style>
  .hero-shell { background: var(--surface-alt); border-bottom: 1px solid var(--line); overflow: hidden; }
  .hero-layout { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(0,.75fr); align-items: center; gap: 3rem; padding-block: 3rem; }
  .hero-copy { min-width: 0; }
  .hero-eyebrow { display: flex; align-items: center; gap: .75rem; color: var(--ink-muted); font-size: .8rem; margin-bottom: 1.5rem; }
  .hero-mark { border-radius: .5rem; }
  .hero-title { color: var(--ink); font-size: clamp(2rem,3.8vw,3.4rem); font-weight: 700; letter-spacing: -.04em; line-height: 1.35; }
  .hero-title > span { display: block; word-break: keep-all; overflow-wrap: anywhere; }
  .hero-title__emphasis { color: var(--accent); }
  .hero-description { color: var(--ink-muted); margin-top: 1.5rem; max-width: 34rem; font-size: 1rem; line-height: 1.85; }
  .hero-actions { margin-top: 1.75rem; }
  .hero-product { display: grid; grid-template-columns: 1fr; align-items: end; min-width: 0; }
  .reader-window { width: min(75%,17rem); margin-left: auto; border: 1px solid var(--line); border-radius: 1rem; overflow: hidden; background: var(--surface); box-shadow: 0 16px 40px rgb(20 47 67 / .1); }
  .reader-window__screen { display: block; width: 100%; height: min(48vh,25rem); object-fit: cover; object-position: top; }
  .hero-weekly-pick { position: relative; width: 90%; margin-top: -4rem; }
  .hero-reassurance-band { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 1.25rem; }
  .hero-assurances { display: flex; flex-wrap: wrap; gap: 1.5rem; color: var(--ink-muted); font-size: .85rem; }
  @media (max-width: 767px) {
    .hero-layout { grid-template-columns: 1fr; gap: 2.5rem; padding-block: 2.5rem; }
    .hero-title { font-size: clamp(1.7rem,5.6vw,2.7rem); }
    .hero-product { max-width: 28rem; width: 100%; margin-inline: auto; }
    .reader-window { width: 68%; }
    .reader-window__screen { height: 23rem; }
    .hero-weekly-pick { width: 84%; }
    .hero-reassurance-band { align-items: flex-start; flex-direction: column; }
    .hero-assurances { gap: .75rem; }
  }
  @media (min-width: 768px) and (max-height: 700px) {
    .hero-layout { padding-block: 1.75rem; }
    .reader-window__screen { height: 15rem; }
    .hero-weekly-pick { margin-top: -2.5rem; }
    .hero-description { margin-top: 1rem; }
    .hero-actions { margin-top: 1.25rem; }
  }
</style>
