---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="mx-auto w-full max-w-64 md:mx-0">
  <a
    href={src.src}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${caption}を拡大して見る（新しいタブ）`}
    class="block overflow-hidden rounded-2xl border border-sepia-300 bg-surface"
  >
    <Image
      src={src}
      alt={alt}
      widths={[320, 640, 960]}
      sizes="(max-width: 380px) 70vw, 256px"
      format="webp"
      loading="lazy"
      decoding="async"
      class="h-auto w-full"
    />
  </a>
  <figcaption class="mt-3 text-sm leading-6 text-sepia-700">
    {caption}<span class="mt-1 block text-xs">画像を開いて拡大できます。</span>
  </figcaption>
</figure>
