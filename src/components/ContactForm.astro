---
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  id?: string;
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const formId = Astro.props.id ?? `contact-form-${Math.random().toString(36).slice(2, 10)}`;
const fieldId = (name: string) => `${formId}-${name}`;

const categories = [
  t('support.form.cat.bug'),
  t('support.form.cat.feature'),
  t('support.form.cat.other'),
];
---

<section>
  <h2 class="text-2xl font-semibold text-sepia-800 mb-4">{t('support.contact.title')}</h2>
  <p class="text-sepia-600 leading-relaxed mb-6">{t('support.contact.body')}</p>

  <div data-form-success tabindex="-1" class="hidden rounded-xl bg-white/60 border border-sepia-100 p-8 text-center">
    <svg class="w-10 h-10 text-kotori-green mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <p class="text-sepia-700 font-medium" data-form-success-message></p>
  </div>

  <form
    id={formId}
    class="rounded-xl bg-white/60 border border-sepia-100 p-6 space-y-6"
    data-contact-form
    data-sending={t('support.form.sending')}
    data-success={t('support.form.success')}
    data-error={t('support.form.error')}
    data-submit={t('support.form.submit')}
    data-unavailable={lang === 'ja' ? '現在、このフォームから送信できません。メッセージは送信されていません。' : 'This form is currently unavailable. Your message has not been sent.'}
    novalidate
  >
    <input type="hidden" name="from_name" value="Kotori Support Form" />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

    <!-- Name -->
    <div>
      <label for={fieldId('name')} class="block text-sm font-medium text-sepia-700 mb-1">{t('support.form.name')}</label>
      <input
        type="text"
        id={fieldId('name')}
        name="name"
        placeholder={t('support.form.name.ph')}
        class="w-full rounded-lg border border-sepia-200 bg-white/80 px-4 py-2.5 text-sm text-sepia-800 placeholder:text-sepia-300 focus:border-sepia-400 focus:ring-1 focus:ring-sepia-400/50 focus:outline-none transition-colors"
      />
    </div>

    <!-- Email -->
    <div>
      <label for={fieldId('email')} class="block text-sm font-medium text-sepia-700 mb-1">
        {t('support.form.email')} <span class="text-sepia-400">*</span>
      </label>
      <input
        type="email"
        id={fieldId('email')}
        name="email"
        required
        placeholder={t('support.form.email.ph')}
        class="w-full rounded-lg border border-sepia-200 bg-white/80 px-4 py-2.5 text-sm text-sepia-800 placeholder:text-sepia-300 focus:border-sepia-400 focus:ring-1 focus:ring-sepia-400/50 focus:outline-none transition-colors"
      />
    </div>

    <!-- Category (radio) -->
    <fieldset>
      <legend class="block text-sm font-medium text-sepia-700 mb-2">
        {t('support.form.category')} <span class="text-sepia-400">*</span>
      </legend>
      <div class="space-y-2">
        {categories.map((cat, i) => (
          <label class="flex items-center gap-3 cursor-pointer group">
            <input
              type="radio"
              name="subject"
              value={cat}
              required
              checked={i === 0}
              class="w-4 h-4 border-sepia-300 text-sepia-800 accent-sepia-800 focus:ring-sepia-400/50"
            />
            <span class="text-sm text-sepia-700 group-hover:text-sepia-900 transition-colors">{cat}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- OS Version -->
    <div>
      <label for={fieldId('os')} class="block text-sm font-medium text-sepia-700 mb-1">{t('support.form.os')}</label>
      <input
        type="text"
        id={fieldId('os')}
        name="OS Version"
        placeholder={t('support.form.os.ph')}
        class="w-full rounded-lg border border-sepia-200 bg-white/80 px-4 py-2.5 text-sm text-sepia-800 placeholder:text-sepia-300 focus:border-sepia-400 focus:ring-1 focus:ring-sepia-400/50 focus:outline-none transition-colors"
      />
    </div>

    <!-- Message -->
    <div>
      <label for={fieldId('message')} class="block text-sm font-medium text-sepia-700 mb-1">
        {t('support.form.message')} <span class="text-sepia-400">*</span>
      </label>
      <textarea
        id={fieldId('message')}
        name="message"
        required
        rows="6"
        placeholder={t('support.form.message.ph')}
        class="w-full rounded-lg border border-sepia-200 bg-white/80 px-4 py-2.5 text-sm text-sepia-800 placeholder:text-sepia-300 focus:border-sepia-400 focus:ring-1 focus:ring-sepia-400/50 focus:outline-none transition-colors resize-none"
      ></textarea>
    </div>

    <p id={fieldId('error')} data-form-error tabindex="-1" role="alert" class="hidden text-sm text-red-700 bg-red-50/80 border border-red-200 rounded-lg px-4 py-2.5"></p>
    <p data-form-status aria-live="polite" class="sr-only"></p>

    <button
      type="submit"
      data-form-submit
      class="rounded-lg bg-sepia-800 px-5 py-2.5 text-sm text-white hover:bg-sepia-900 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
    >
      {t('support.form.submit')}
    </button>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const section = form.parentElement;
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-form-submit]');
    const errorEl = form.querySelector<HTMLParagraphElement>('[data-form-error]');
    const statusEl = form.querySelector<HTMLParagraphElement>('[data-form-status]');
    const successEl = section?.querySelector<HTMLDivElement>('[data-form-success]');
    const successMsg = section?.querySelector<HTMLParagraphElement>('[data-form-success-message]');

    if (!submitBtn || !errorEl || !statusEl || !successEl || !successMsg) return;

    const clearValidation = () => {
      form.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((field) => {
        field.removeAttribute('aria-invalid');
        field.removeAttribute('aria-describedby');
      });
      errorEl.classList.add('hidden');
      statusEl.textContent = '';
    };

    form.addEventListener('input', clearValidation);
    form.addEventListener('change', clearValidation);
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const invalidField = Array.from(form.elements).find((field) => (
        field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement
      ) && !field.disabled && !field.checkValidity()) as HTMLElement | undefined;

      if (invalidField) {
        invalidField.setAttribute('aria-invalid', 'true');
        invalidField.setAttribute('aria-describedby', errorEl.id);
        errorEl.textContent = form.dataset.error ?? '';
        errorEl.classList.remove('hidden');
        statusEl.textContent = form.dataset.error ?? '';
        invalidField.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = form.dataset.sending ?? '';
      statusEl.textContent = form.dataset.sending ?? '';
      errorEl.classList.add('hidden');
      form.setAttribute('aria-busy', 'true');

      // Submission is unavailable until the original integration can be restored.
      form.removeAttribute('aria-busy');
      submitBtn.disabled = false;
      submitBtn.textContent = form.dataset.submit ?? '';
      errorEl.textContent = form.dataset.unavailable ?? '';
      errorEl.classList.remove('hidden');
      statusEl.textContent = form.dataset.unavailable ?? '';
      errorEl.focus();
    });
  });
</script>
