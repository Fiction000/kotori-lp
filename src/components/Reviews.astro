---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import ReviewCollection from './shared/ReviewCollection.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const reviews = [
  { quote: t('reviews.quote1'), source: t('reviews.source') },
  { quote: t('reviews.quote2'), source: t('reviews.source') },
];
---

<ReviewCollection
  id="reviews"
  reviews={reviews}
  title={t('reviews.title')}
  note={t('reviews.note')}
  lang={lang}
/>
