---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const primaryFeature = {
  title: t('features.vertical.title'),
  description: t('features.vertical.description'),
  screenshot: '/screenshots/screenshot-1-800-v1.webp',
  screenshotSet: '/screenshots/screenshot-1-480-v1.webp 480w, /screenshots/screenshot-1-800-v1.webp 800w',
  alt: lang === 'ja' ? '美しい縦書きレイアウト' : 'Beautiful vertical text layout',
};

const proofFeatures = [
  {
    title: t('features.furigana.title'),
    description: t('features.furigana.description'),
    screenshot: '/screenshots/screenshot-2-800-v1.webp',
    screenshotSet: '/screenshots/screenshot-2-480-v1.webp 480w, /screenshots/screenshot-2-800-v1.webp 800w',
    alt: lang === 'ja' ? '作家や作品をかんたん検索' : 'Search authors and works easily',
    wide: true,
  },
  {
    title: t('features.dictionary.title'),
    description: t('features.dictionary.description'),
    screenshot: '/screenshots/screenshot-3-800-v1.webp',
    screenshotSet: '/screenshots/screenshot-3-480-v1.webp 480w, /screenshots/screenshot-3-800-v1.webp 800w',
    alt: lang === 'ja' ? 'タップで辞書検索' : 'Tap to look up words',
  },
  {
    title: t('features.highlights.title'),
    description: t('features.highlights.description'),
    screenshot: '/screenshots/screenshot-4-800-v1.webp',
    screenshotSet: '/screenshots/screenshot-4-480-v1.webp 480w, /screenshots/screenshot-4-800-v1.webp 800w',
    alt: lang === 'ja' ? 'ハイライトと読書メモ' : 'Highlights and reading notes',
  },
];

const utilityFeatures = [
  {
    title: t('features.themes.title'),
    description: t('features.themes.description'),
  },
  {
    title: t('features.offline.title'),
    description: t('features.offline.description'),
  },
];
---

<section id="features" class="features-section pt-24 pb-16 md:pt-32 md:pb-24">
  <div class="mx-auto max-w-6xl px-6">
    <header class="fade-up features-intro">
      <h2 class="font-koburi text-3xl leading-tight text-sepia-900 md:text-4xl">{t('features.title')}</h2>
    </header>

    <article class="fade-up feature-lead">
      <div class="feature-lead__copy">
        <h3 class="font-koburi text-3xl leading-tight text-sepia-900 md:text-5xl">
          {primaryFeature.title}
        </h3>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-sepia-700 md:text-xl">
          {primaryFeature.description}
        </p>
      </div>
      <figure class="feature-lead__visual">
        <img
          src={primaryFeature.screenshot}
          srcset={primaryFeature.screenshotSet}
          sizes="(min-width: 768px) 420px, min(82vw, 420px)"
          alt={primaryFeature.alt}
          width="800"
          height="1739"
          loading="lazy"
        />
      </figure>
    </article>

    <div class="proof-grid stagger-children" aria-label={t('features.title')}>
      {proofFeatures.map((feature) => (
        <article class:list={['fade-up', 'proof-card', feature.wide && 'proof-card--wide']}>
          <div class="proof-card__copy">
            <h3 class="font-koburi text-2xl leading-tight text-sepia-900 md:text-3xl">{feature.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-sepia-700 md:text-lg">{feature.description}</p>
          </div>
          <figure class="proof-card__visual">
            <img
              src={feature.screenshot}
              srcset={feature.screenshotSet}
              sizes="(min-width: 768px) 620px, calc(100vw - 96px)"
              alt={feature.alt}
              width="800"
              height="1739"
              loading="lazy"
            />
          </figure>
        </article>
      ))}
    </div>

    <div class="utility-features stagger-children">
      {utilityFeatures.map((feature) => (
        <article class="fade-up utility-feature">
          <h3 class="font-koburi text-xl leading-tight text-sepia-900 md:text-2xl">{feature.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-sepia-700">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features-intro {
    margin-bottom: 2.5rem;
  }

  .feature-lead {
    display: grid;
    align-items: center;
    gap: 2.5rem;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-alt);
  }

  .feature-lead__copy {
    order: 2;
  }

  .feature-lead__visual {
    width: 100%;
    max-width: 25rem;
    max-height: 34rem;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: 0 18px 40px rgba(82, 58, 34, 0.09);
  }

  .feature-lead__visual img,
  .proof-card__visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  .proof-card {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
    padding: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .proof-card__copy {
    align-self: center;
  }

  .proof-card__visual {
    height: 19rem;
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface-alt);
  }

  .proof-card__visual img {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .proof-card:nth-child(2) .proof-card__visual img {
    object-position: center 63%;
  }

  .utility-features {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .utility-feature {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .proof-card:hover {
      transform: translateY(-0.25rem);
      box-shadow: 0 16px 32px rgba(82, 58, 34, 0.08);
    }
  }

  @media (min-width: 768px) {
    .feature-lead {
      grid-template-columns: minmax(0, 0.85fr) minmax(17rem, 0.65fr);
      gap: clamp(3rem, 7vw, 6rem);
    }

    .feature-lead__copy {
      order: initial;
    }

    .feature-lead__visual {
      width: 100%;
    }

    .proof-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    }

    .proof-card--wide {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(15rem, 1.2fr);
      align-items: center;
      min-height: 22rem;
      padding: 2rem;
    }

    .proof-card--wide .proof-card__visual {
      max-height: 18rem;
    }

    .proof-card:not(.proof-card--wide) {
      grid-template-rows: auto minmax(17rem, 1fr);
      padding: 2rem;
    }

    .proof-card:not(.proof-card--wide) .proof-card__visual {
      max-height: 23rem;
    }

    .utility-features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
      margin-top: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-card {
      transition: none;
    }
  }
</style>
