---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import AppStoreBadge from './AppStoreBadge.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pairedFeatures = [
  {
    title: t('features.vertical.title'),
    description: t('features.vertical.description'),
    screenshot: '/screenshots/screenshot-1-800-v1.webp',
    screenshotSet: '/screenshots/screenshot-1-480-v1.webp 480w, /screenshots/screenshot-1-800-v1.webp 800w',
    caption: lang === 'ja' ? '美しい縦書きレイアウト' : 'Beautiful vertical text layout',
  },
  {
    title: t('features.furigana.title'),
    description: t('features.furigana.description'),
  },
  {
    title: t('features.dictionary.title'),
    description: t('features.dictionary.description'),
    screenshot: '/screenshots/screenshot-3-800-v1.webp',
    screenshotSet: '/screenshots/screenshot-3-480-v1.webp 480w, /screenshots/screenshot-3-800-v1.webp 800w',
    caption: lang === 'ja' ? 'タップで辞書検索' : 'Tap to look up words',
  },
  {
    title: t('features.highlights.title'),
    description: t('features.highlights.description'),
    screenshot: '/screenshots/screenshot-4-800-v1.webp',
    screenshotSet: '/screenshots/screenshot-4-480-v1.webp 480w, /screenshots/screenshot-4-800-v1.webp 800w',
    caption: lang === 'ja' ? 'ハイライトと読書メモ' : 'Highlights and reading notes',
  },
];

const textOnlyFeatures = [
  {
    title: t('features.themes.title'),
    description: t('features.themes.description'),
  },
  {
    title: t('features.offline.title'),
    description: t('features.offline.description'),
  },
];
---

<section id="features" class="relative isolate overflow-hidden pt-16 pb-12 md:pt-20 md:pb-16">
  <div class="relative z-[1] mx-auto max-w-6xl px-6">

    <!-- Primary feature: hero-scale with screenshot -->
    <div class="fade-up mb-14 md:mb-20">
      <div class="feature-row feature-row--primary">
        <!-- Screenshot side -->
        <div class="feature-screenshot feature-screenshot--primary">
          <div class="phone-frame">
            <img
              src={pairedFeatures[0].screenshot}
              srcset={pairedFeatures[0].screenshotSet}
              sizes="(min-width: 768px) 360px, 70vw"
              alt={pairedFeatures[0].caption}
              width="800"
              height="1739"
              class="phone-screen"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Text side -->
        <div class="feature-text feature-text--primary">
          <h2 class="font-koburi text-3xl md:text-4xl text-sepia-900 mb-4 leading-tight">
            {pairedFeatures[0].title}
          </h2>
          <p class="text-sepia-600 text-lg md:text-xl leading-relaxed max-w-md">
            {pairedFeatures[0].description}
          </p>
        </div>
      </div>
    </div>

    <div class="fade-up feature-search">
      <h3 class="font-koburi text-2xl md:text-3xl text-sepia-800 mb-3 leading-tight">
        {pairedFeatures[1].title}
      </h3>
      <p class="max-w-xl text-base leading-relaxed text-sepia-700 md:text-lg">
        {pairedFeatures[1].description}
      </p>
    </div>

    <!-- Secondary paired features: alternating screenshot + text -->
    <div class="mb-12 md:mb-16">
      {pairedFeatures.slice(2).map((feature, i) => (
        <div class="fade-up">
          <div class:list={[
            'feature-row',
            'feature-row--detail',
            i % 2 === 0 ? 'feature-row--reverse' : '',
          ]}>
            <!-- Screenshot -->
            <div class:list={[
              'feature-screenshot',
              'feature-screenshot--crop',
              i === 0 ? 'feature-screenshot--dictionary' : 'feature-screenshot--highlights',
            ]}>
              <div class="phone-frame">
                <img
                  src={feature.screenshot}
                  srcset={feature.screenshotSet}
                  sizes="(min-width: 420px) 176px, 42vw"
                  alt={feature.caption}
                  width="800"
                  height="1739"
                  class="phone-screen"
                  loading="lazy"
                />
              </div>
            </div>
            <!-- Text -->
            <div class:list={[
              'feature-text',
              i % 2 === 0 ? 'feature-text--right' : '',
            ]}>
              <h3 class="font-koburi text-2xl md:text-3xl text-sepia-800 mb-3 leading-tight">
                {feature.title}
              </h3>
              <p class="max-w-md text-base leading-relaxed text-sepia-700 md:text-lg">
                {feature.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Text-only features: compact pair -->
    <div class="fade-up">
      <div class="text-features-grid">
        {textOnlyFeatures.map((feature) => (
          <div class="text-feature-card">
            <h3 class="font-koburi text-xl md:text-2xl text-sepia-800 mb-2 leading-tight">
              {feature.title}
            </h3>
            <p class="text-base leading-relaxed text-sepia-700">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <div class="fade-up feature-proof-cta">
      <AppStoreBadge location="feature_proof" />
    </div>

  </div>
</section>

<style>
  /* ── Paired feature rows ── */
  .feature-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .feature-row {
      flex-direction: row;
      gap: 4rem;
    }

    .feature-row--reverse {
      flex-direction: row-reverse;
    }

    .feature-row--primary {
      gap: 5rem;
    }
  }

  .feature-row--detail {
    padding-block: 2rem;
  }

  /* ── Screenshot / phone ── */
  .feature-screenshot {
    flex-shrink: 0;
    width: 70%;
    max-width: 300px;
    margin: 0 auto;
  }

  .feature-screenshot--primary {
    max-width: 340px;
  }

  .feature-screenshot--crop {
    width: min(42vw, 11rem);
    height: 12.5rem;
  }

  .feature-screenshot--crop .phone-frame {
    height: 100%;
    overflow: hidden;
  }

  .feature-screenshot--crop .phone-screen {
    height: 100%;
    object-fit: cover;
  }

  .feature-screenshot--dictionary .phone-screen { object-position: center 70%; }
  .feature-screenshot--highlights .phone-screen { object-position: center 38%; }

  @media (min-width: 768px) {
    .feature-screenshot {
      width: auto;
      max-width: 320px;
      margin: 0;
    }

    .feature-screenshot--primary {
      max-width: 360px;
    }

    .feature-screenshot--crop {
      width: 11rem;
      height: 13.25rem;
    }
  }

  .phone-frame {
    background: white;
    padding: 0.35rem;
    border-radius: 1.25rem;
    box-shadow:
      0 4px 24px rgba(82, 58, 34, 0.08),
      0 0 0 1px rgba(82, 58, 34, 0.04);
  }

  .phone-screen {
    width: 100%;
    border-radius: 0.95rem;
    display: block;
  }

  /* ── Feature text ── */
  .feature-text {
    text-align: center;
  }

  @media (min-width: 768px) {
    .feature-text {
      text-align: left;
      flex: 1;
    }

    .feature-text--right {
      text-align: right;
    }

    .feature-text--right p {
      margin-left: auto;
    }

    .feature-text--primary {
      flex: 1;
    }
  }

  .feature-search {
    padding: 2rem 0;
    border-top: 1px solid rgba(82, 58, 34, 0.14);
    border-bottom: 1px solid rgba(82, 58, 34, 0.14);
    text-align: center;
  }

  .feature-proof-cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .feature-search {
      display: grid;
      grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1fr);
      align-items: baseline;
      gap: 3rem;
      padding: 2.5rem 0;
      text-align: left;
    }
  }

  /* ── Text-only feature close ── */
  .text-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgba(82, 58, 34, 0.14);
    border-bottom: 1px solid rgba(82, 58, 34, 0.14);
  }

  @media (min-width: 640px) {
    .text-features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .text-feature-card {
    padding: 2rem 0;
  }

  .text-feature-card + .text-feature-card {
    border-top: 1px solid rgba(82, 58, 34, 0.14);
  }

  @media (min-width: 640px) {
    .text-feature-card {
      padding: 2.5rem 3rem 2.5rem 0;
    }

    .text-feature-card + .text-feature-card {
      border-top: 0;
      border-left: 1px solid rgba(82, 58, 34, 0.14);
      padding-right: 0;
      padding-left: 3rem;
    }
  }
</style>
