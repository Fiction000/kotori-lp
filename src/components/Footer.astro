---
import { getLangFromUrl, useTranslations, getLocalePath } from '../i18n/utils';
import { analyticsEnabled } from '../lib/analytics';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="border-t border-sepia-200/50 py-16 md:py-20">
  <div class="mx-auto max-w-5xl px-6">
    <!-- Colophon (奥付) style -->
    <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-12">

      <!-- Left: Book-style colophon info -->
      <div class="colophon-block text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-3 mb-4">
          <img src="/app-icon-288-v1.webp" alt="" width="288" height="288" class="w-8 h-8 rounded-lg" />
          <span class="font-koburi text-xl text-sepia-800">{t('brand.name')}</span>
        </div>
        <dl class="colophon-list space-y-1 text-sm text-sepia-700">
          <div class="flex gap-3 justify-center md:justify-start">
            <dt class="shrink-0 font-medium text-sepia-600">{lang === 'ja' ? '種別' : 'Type'}</dt>
            <dd>{lang === 'ja' ? 'iOS アプリケーション' : 'iOS Application'}</dd>
          </div>
          <div class="flex gap-3 justify-center md:justify-start">
            <dt class="shrink-0 font-medium text-sepia-600">{lang === 'ja' ? '価格' : 'Price'}</dt>
            <dd>{lang === 'ja' ? '無料' : 'Free'}</dd>
          </div>
          <div class="flex gap-3 justify-center md:justify-start">
            <dt class="shrink-0 font-medium text-sepia-600">{lang === 'ja' ? '対応' : 'Source'}</dt>
            <dd>{lang === 'ja' ? '青空文庫' : 'Aozora Bunko'}</dd>
          </div>
        </dl>
      </div>

      <!-- Center: Vertical text accent -->
      <div class="hidden md:block select-none" aria-hidden="true">
        <span class="font-koburi text-sepia-600 writing-vertical text-lg tracking-[0.3em] leading-relaxed">
          {lang === 'ja' ? '読書は心の旅である' : '読書は心の旅である'}
        </span>
      </div>

      <!-- Right: Navigation -->
      <nav class="flex flex-col items-center md:items-end gap-2 text-sm">
        {lang === 'ja' && (
          <a href="/works/" class="text-sepia-700 transition-colors hover:text-sepia-900">
            {t('footer.works')}
          </a>
        )}
        <a href={getLocalePath(lang, '/weekly/')} class="text-sepia-700 transition-colors hover:text-sepia-900">
          {t('footer.weekly')}
        </a>
        <a href={getLocalePath(lang, '/changelog')} class="text-sepia-700 transition-colors hover:text-sepia-900">
          {t('footer.changelog')}
        </a>
        <a href={getLocalePath(lang, '/privacy')} class="text-sepia-700 transition-colors hover:text-sepia-900">
          {t('footer.privacy')}
        </a>
        <a href={getLocalePath(lang, '/support')} class="text-sepia-700 transition-colors hover:text-sepia-900">
          {t('footer.support')}
        </a>
        {analyticsEnabled && (
          <button type="button" data-analytics-settings class="text-sepia-700 transition-colors hover:text-sepia-900">
            {lang === 'ja' ? 'アクセス解析の設定' : 'Analytics settings'}
          </button>
        )}
      </nav>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-6 border-t border-sepia-100">
      <p class="text-center text-sm tracking-wide text-sepia-600">
        {t('footer.copyright')}
      </p>
    </div>
  </div>
</footer>

<style>
  .writing-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
</style>
