---
import { getLangFromUrl } from '../i18n/utils';
import AppStoreBadge from './AppStoreBadge.astro';

interface Props {
  variant?: 'compact' | 'closing';
  location?: string;
}

const lang = getLangFromUrl(Astro.url);
const variant = Astro.props.variant ?? 'compact';
const location = Astro.props.location ?? (variant === 'closing' ? 'closing_cta' : 'compact_cta');

const copy = lang === 'ja'
  ? {
      compactTitle: '気になる一冊を、コトリで。',
      closingTitle: '日本文学の名作を、あなたの手のひらに。',
      reassurance: '無料・広告なし・オフライン対応',
    }
  : {
      compactTitle: 'Find your next read with Kotori.',
      closingTitle: 'Japanese literary classics, in the palm of your hand.',
      reassurance: 'Free, no ads, works offline',
    };
---

{variant === 'closing' ? (
  <section class="relative overflow-hidden py-28 md:py-40">
    <div class="relative mx-auto max-w-3xl px-6 text-center">
      <h2 class="fade-up font-koburi text-2xl md:text-3xl text-sepia-700 leading-relaxed mb-4">
        {copy.closingTitle}
      </h2>
      <p class="fade-up mb-12 text-base text-sepia-700 md:text-lg">{copy.reassurance}</p>
      <div class="fade-up">
        <AppStoreBadge location={location} />
      </div>
    </div>
  </section>
) : (
  <section class="download-cta fade-up" aria-label={lang === 'ja' ? 'コトリをダウンロード' : 'Download Kotori'}>
    <div class="download-cta__inner mx-auto max-w-5xl px-6">
      <div class="download-cta__copy">
        <h2 class="font-koburi text-3xl leading-tight text-sepia-900 md:text-4xl">{copy.compactTitle}</h2>
        <p class="mt-3 text-sm leading-7 text-sepia-700 md:text-base">{copy.reassurance}</p>
      </div>
      <div class="download-cta__action">
        <AppStoreBadge variant="light" location={location} />
      </div>
    </div>
  </section>
)}

<style>
  .writing-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .download-cta {
    padding: 4.5rem 0;
  }

  .download-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid rgba(23, 107, 155, 0.36);
    border-bottom: 1px solid rgba(23, 107, 155, 0.36);
    background: var(--surface-alt);
    padding-top: 2.25rem;
    padding-bottom: 2.25rem;
  }

  .download-cta__copy {
    max-width: 38rem;
  }

  .download-cta__action {
    flex: none;
  }

  @media (max-width: 47.99rem) {
    .download-cta {
      padding: 3.5rem 0;
    }

    .download-cta__inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
      padding-top: 1.75rem;
      padding-bottom: 1.75rem;
    }
  }
</style>
