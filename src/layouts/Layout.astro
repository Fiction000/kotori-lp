---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = Astro.props.title || t('meta.title');
const description = Astro.props.description || t('meta.description');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const basePath = lang === 'en'
  ? (Astro.url.pathname.replace(/^\/en/, '') || '/')
  : Astro.url.pathname;
const jaURL = new URL(basePath, Astro.site);
const enURL = new URL(`/en${basePath === '/' ? '/' : basePath}`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('motion-ready');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/app-icon-180.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="ja" href={jaURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={jaURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/app-icon.png', Astro.site)} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/app-icon.png', Astro.site)} />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Kotori',
        url: new URL('/', Astro.site).toString(),
        downloadUrl: 'https://apps.apple.com/jp/app/%E3%82%B3%E3%83%88%E3%83%AA-%E3%83%A2%E3%83%80%E3%83%B3%E9%9D%92%E7%A9%BA%E6%96%87%E5%BA%AB%E3%83%AA%E3%83%BC%E3%83%80%E3%83%BC/id6759166859',
        operatingSystem: 'iOS',
        applicationCategory: 'BooksApplication',
        description: description,
        inLanguage: lang,
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'JPY',
        },
      })}
    />

    <link rel="preload" href="/fonts/GenEiKoburiMin6-R.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-kotori-warm text-kotori-dark antialiased">
    <!-- ページめくりアニメーション -->
    <div id="page-turn">
      <div class="page-turn__back"></div>
      <div class="page-turn__page"></div>
    </div>

    <slot />
    <script>
      function startObserver() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
      }

      startObserver();

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const overlay = document.getElementById('page-turn');
      let hasSeenPageTurn = false;

      function finishPageTurn() {
        if (overlay) overlay.style.display = 'none';
      }

      try {
        hasSeenPageTurn = sessionStorage.getItem('kotori-page-turn-seen') === 'true';
      } catch {
        // Storage can be unavailable in privacy-restricted browsing contexts.
      }

      if (prefersReducedMotion || hasSeenPageTurn) {
        finishPageTurn();
      } else {
        try {
          sessionStorage.setItem('kotori-page-turn-seen', 'true');
        } catch {
          // The animation still works when session storage is unavailable.
        }

        const delay = window.innerWidth < 768 ? 900 : 1200;
        setTimeout(finishPageTurn, delay);
      }
    </script>
  </body>
</html>
