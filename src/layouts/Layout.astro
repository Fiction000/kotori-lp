---
import '../styles/global.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  alternateLocales?: Array<'ja' | 'en'>;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  includeSoftwareApplicationSchema?: boolean;
  ogType?: 'website' | 'article' | 'book';
  ogImage?: string;
  socialTitle?: string;
  socialDescription?: string;
  robots?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = Astro.props.title || t('meta.title');
const description = Astro.props.description || t('meta.description');
const alternateLocales = Astro.props.alternateLocales ?? ['ja', 'en'];
const structuredData = Astro.props.structuredData;
const includeSoftwareApplicationSchema = Astro.props.includeSoftwareApplicationSchema ?? true;
const ogType = Astro.props.ogType ?? 'website';
const ogImage = new URL(Astro.props.ogImage ?? '/app-icon.png', Astro.site);
const socialTitle = Astro.props.socialTitle ?? title;
const socialDescription = Astro.props.socialDescription ?? description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const basePath = lang === 'en'
  ? (Astro.url.pathname.replace(/^\/en/, '') || '/')
  : Astro.url.pathname;
const jaURL = new URL(basePath, Astro.site);
const enURL = new URL(`/en${basePath === '/' ? '/' : basePath}`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('motion-ready');</script>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/app-icon-180.png" />
    <link rel="canonical" href={canonicalURL} />
    {alternateLocales.includes('ja') && <link rel="alternate" hreflang="ja" href={jaURL} />}
    {alternateLocales.includes('en') && <link rel="alternate" hreflang="en" href={enURL} />}
    {alternateLocales.includes('ja') && <link rel="alternate" hreflang="x-default" href={jaURL} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    {Astro.props.robots && <meta name="robots" content={Astro.props.robots} />}

    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content={Astro.props.ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    {includeSoftwareApplicationSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'SoftwareApplication',
          name: 'Kotori',
          url: new URL('/', Astro.site).toString(),
          downloadUrl: 'https://apps.apple.com/jp/app/%E3%82%B3%E3%83%88%E3%83%AA-%E3%83%A2%E3%83%80%E3%83%B3%E9%9D%92%E7%A9%BA%E6%96%87%E5%BA%AB%E3%83%AA%E3%83%BC%E3%83%80%E3%83%BC/id6759166859',
          operatingSystem: 'iOS',
          applicationCategory: 'BooksApplication',
          description: description,
          inLanguage: lang,
          offers: {
            '@type': 'Offer',
            price: '0',
            priceCurrency: 'JPY',
          },
        })}
      />
    )}
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}

    <link rel="preload" href="/fonts/GenEiKoburiMin6-R.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <GoogleAnalytics />
  </head>
  <body class="bg-kotori-warm text-kotori-dark antialiased">
    <a class="skip-link" href="#main-content">{lang === 'ja' ? '本文へ移動' : 'Skip to content'}</a>
    <slot />
    <AnalyticsConsent />
    <script>
      function startObserver() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
      }

      startObserver();
    </script>
  </body>
</html>
