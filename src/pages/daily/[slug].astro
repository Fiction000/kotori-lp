---
import { readyPicks } from '../../data/editorial';
import { workPagePathForWeeklyID } from '../../data/work-pages';

export function getStaticPaths() {
  return readyPicks().map((pick) => ({ params: { slug: pick.id }, props: { pick } }));
}

const { pick } = Astro.props;
const permanentPath = workPagePathForWeeklyID(pick.id);
return Astro.redirect(permanentPath ?? `/weekly/${pick.id}/`, 308);
---
