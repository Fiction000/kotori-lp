---
import { readyPicks } from '../../data/editorial';

export function getStaticPaths() {
  return readyPicks()
    .filter((pick) => pick.id !== 'kokoro')
    .map((pick) => ({ params: { slug: pick.id }, props: { pick } }));
}

const { pick } = Astro.props;
return Astro.redirect(`/weekly/${pick.id}/`, 308);
---
