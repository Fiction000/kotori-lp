---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DailyPickDetail from '../../components/DailyPickDetail.astro';
import { localizedPick, readyPicks } from '../../data/editorial';

export function getStaticPaths() {
  return readyPicks().map((pick) => ({ params: { slug: pick.id }, props: { pick } }));
}

const { pick } = Astro.props;
const content = localizedPick(pick, 'ja');
---

<Layout title={`${content.title} - 今日の1冊 - コトリ`} description={`${content.title}（${content.author}）の読みどころと背景を紹介します。`}>
  <Header />
  <main><DailyPickDetail lang="ja" pick={pick} /></main>
  <Footer />
</Layout>
