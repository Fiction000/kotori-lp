---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WeeklyPickDetail from '../../components/WeeklyPickDetail.astro';
import { localizedPick, readyPicks } from '../../data/editorial';
import { workPagePathForWeeklyID } from '../../data/work-pages';

export const prerender = false;

const pick = readyPicks().find((candidate) => candidate.id === Astro.params.slug);
if (!pick) return new Response(null, { status: 404 });
const permanentPath = workPagePathForWeeklyID(pick.id);
if (permanentPath) return Astro.redirect(permanentPath, 308);
const content = localizedPick(pick, 'ja');
---

<Layout title={`${content.title}の読みどころ｜${content.author}｜コトリ`} description={`青空文庫の${content.title}（${content.author}）について、読みどころと読む前に知っておきたい背景を紹介します。`}>
  <Header />
  <main id="main-content"><WeeklyPickDetail lang="ja" pick={pick} /></main>
  <Footer />
</Layout>
