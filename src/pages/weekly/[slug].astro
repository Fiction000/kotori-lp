---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WeeklyPickDetail from '../../components/WeeklyPickDetail.astro';
import { localizedPick, readyPicks } from '../../data/editorial';

export function getStaticPaths() {
  return readyPicks()
    .filter((pick) => pick.id !== 'kokoro')
    .map((pick) => ({ params: { slug: pick.id }, props: { pick } }));
}

const { pick } = Astro.props;
const content = localizedPick(pick, 'ja');
---

<Layout title={`${content.title}の読みどころ｜${content.author}｜コトリ`} description={`青空文庫の${content.title}（${content.author}）について、読みどころと読む前に知っておきたい背景を紹介します。`}>
  <Header />
  <main><WeeklyPickDetail lang="ja" pick={pick} /></main>
  <Footer />
</Layout>
