export const prerender = false;
---

<Layout title="青空文庫「今週の1冊」｜作品の読みどころ｜コトリ" description="青空文庫から今週読みたい一冊を選び、作品の読みどころと背景を紹介します。">
  <Header />
  <main id="main-content"><WeeklyPickIndex lang="ja" /></main>
  <Footer />
</Layout>
