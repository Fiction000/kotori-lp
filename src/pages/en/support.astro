---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqs = [
  { q: t('support.faq.q1'), a: t('support.faq.a1') },
  { q: t('support.faq.q2'), a: t('support.faq.a2') },
  { q: t('support.faq.q3'), a: t('support.faq.a3') },
  { q: t('support.faq.q4'), a: t('support.faq.a4') },
];
---

<Layout title={`${t('support.title')} — Kotori`}>
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <h1 class="text-3xl md:text-4xl font-bold text-sepia-900 mb-12" style={`font-family: var(--font-serif-jp)`}>
      {t('support.title')}
    </h1>

    <section class="mb-16">
      <h2 class="text-2xl font-semibold text-sepia-800 mb-8">{t('support.faq.title')}</h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="rounded-xl bg-white/60 border border-sepia-100 p-6">
            <h3 class="text-lg font-semibold text-sepia-800 mb-2">{faq.q}</h3>
            <p class="text-sepia-600 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-semibold text-sepia-800 mb-4">{t('support.contact.title')}</h2>
      <p class="text-sepia-600 leading-relaxed mb-4">{t('support.contact.body')}</p>
      <a
        href="https://equable-witch-a9b.notion.site/32a156cdcb89807e9f22dcd854dc4ab4?pvs=105"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-sepia-800 px-5 py-2.5 text-sm text-white hover:bg-sepia-900 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
        {t('support.contact.github')}
      </a>
    </section>
  </main>
  <Footer />
</Layout>
