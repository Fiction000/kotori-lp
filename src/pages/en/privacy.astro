---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sections = [
  { title: t('privacy.collection.title'), body: t('privacy.collection.body') },
  { title: t('privacy.website.title'), body: t('privacy.website.body') },
  { title: t('privacy.contactForm.title'), body: t('privacy.contactForm.body') },
  { title: t('privacy.location.title'), body: t('privacy.location.body') },
  { title: t('privacy.thirdparty.title'), body: t('privacy.thirdparty.body') },
  { title: t('privacy.optout.title'), body: t('privacy.optout.body') },
  { title: t('privacy.children.title'), body: t('privacy.children.body') },
  { title: t('privacy.security.title'), body: t('privacy.security.body') },
  { title: t('privacy.changes.title'), body: t('privacy.changes.body') },
  { title: t('privacy.consent.title'), body: t('privacy.consent.body') },
  { title: t('privacy.contact.title'), body: t('privacy.contact.body') },
];
---

<Layout title={`${t('privacy.title')} | Kotori`} description={t('privacy.meta.description')}>
  <Header />
  <main id="main-content" class="mx-auto max-w-[42rem] px-6 py-16 md:py-24">
    <h1 class="font-koburi text-3xl text-sepia-900 md:text-4xl" style={`font-family: var(--font-serif-jp)`}>
      {t('privacy.title')}
    </h1>
    <p class="mt-3 text-sm text-sepia-700">{t('privacy.lastUpdated')}</p>
    <p class="mt-9 max-w-[65ch] leading-8 text-sepia-700">{t('privacy.intro')}</p>

    {sections.map((section) => (
      <div class="mt-10 border-t border-sepia-200 pt-7">
        <h2 class="font-koburi text-xl text-sepia-900">{section.title}</h2>
        <p class="mt-3 max-w-[65ch] leading-8 text-sepia-700">{section.body}</p>
      </div>
    ))}
  </main>
  <Footer />
</Layout>
