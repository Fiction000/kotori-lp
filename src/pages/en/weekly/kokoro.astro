---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WeeklyPickDetail from '../../../components/WeeklyPickDetail.astro';
import { localizedPick, readyPicks } from '../../../data/editorial';

const pick = readyPicks().find((candidate) => candidate.id === 'kokoro');
if (!pick) throw new Error('The Kokoro weekly pick is missing.');
const content = localizedPick(pick, 'en');
---

<Layout
  title={`${content.title} Reading Guide | Kotori`}
  description={`Discover why ${content.title} by ${content.author} is worth reading, with a brief introduction and literary background.`}
  alternateLocales={['en']}
  robots="noindex,follow"
>
  <Header showLanguageSwitcher={false} />
  <main><WeeklyPickDetail lang="en" pick={pick} /></main>
  <Footer />
</Layout>
