---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WorkCardList from '../../components/WorkCardList.astro';
import { collectionPath, readyCollections, workPagesForCollection, type CuratedCollection } from '../../data/work-catalog';
import { workPagePath } from '../../data/work-pages';

export function getStaticPaths() {
  return readyCollections().map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}

interface Props { collection: CuratedCollection; }
const { collection } = Astro.props;
const collectionWorks = workPagesForCollection(collection);
const works = collectionWorks.map(({ work }) => work);
const reasonsByBookID = Object.fromEntries(collectionWorks.map(({ work, reason }) => [work.bookID, reason]));
const canonicalURL = new URL(collectionPath(collection), Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': `${canonicalURL}#page`, url: canonicalURL, name: collection.seo.title, mainEntity: { '@type': 'ItemList', itemListElement: works.map((work, index) => ({ '@type': 'ListItem', position: index + 1, name: work.title, url: new URL(workPagePath(work), Astro.site).toString() })) } },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).toString() }, { '@type': 'ListItem', position: 2, name: collection.name, item: canonicalURL }] },
  ],
};
---

<Layout title={collection.seo.title} description={collection.seo.description} alternateLocales={['ja']} structuredData={structuredData}>
  <Header showLanguageSwitcher={false} />
  <main><section class="border-b border-sepia-200/70 py-24 md:py-32"><div class="mx-auto max-w-5xl px-6"><nav aria-label="パンくず" class="text-xs text-sepia-600"><a href="/" class="hover:text-sepia-900">ホーム</a> ／ <span aria-current="page">{collection.name}</span></nav><p class="mt-12 text-xs font-semibold tracking-[0.22em] text-sepia-600">KOTORI COLLECTION</p><h1 class="mt-5 font-koburi text-5xl text-sepia-900 md:text-7xl">{collection.name}</h1><p class="mt-7 max-w-2xl text-lg leading-9 text-sepia-700">{collection.introduction}</p></div></section><section class="py-20 md:py-28"><div class="mx-auto max-w-5xl px-6"><WorkCardList works={works} reasonsByBookID={reasonsByBookID} /></div></section></main>
  <Footer />
</Layout>
