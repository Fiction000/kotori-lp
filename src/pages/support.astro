---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<Layout title={`${t('support.title')}｜コトリ`} description={t('support.meta.description')}>
  <Header />
  <main id="main-content" class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <h1 class="text-3xl md:text-4xl font-bold text-sepia-900 mb-12" style={`font-family: var(--font-serif-jp)`}>
      {t('support.title')}
    </h1>

    <FAQ variant="support" />

    <ContactForm />
  </main>
  <Footer />
</Layout>
